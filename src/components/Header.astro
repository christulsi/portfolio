---
import { Icon } from 'astro-icon/components';

const base = import.meta.env.BASE_URL ?? '/';

const navLinks = [
  { href: `${base}#about`, label: 'About' },
  { href: `${base}#projects`, label: 'Projects' },
  { href: `${base}#experience`, label: 'Experience' },
  { href: `${base}#contact`, label: 'Contact' },
];
---

<header
  class="sticky top-0 z-[1000] border-b border-hairline/10 bg-canvas/80 backdrop-blur-md transition-colors"
>
  <nav class="container py-3 md:py-4">
    <div class="flex items-center justify-between">
      <a href={base} class="group flex items-center gap-3 font-mono">
        <span
          class="flex h-9 w-9 items-center justify-center rounded-md border border-primary/60 text-sm font-bold text-primary transition-colors duration-300 group-hover:bg-primary group-hover:text-[rgb(var(--accent-contrast))]"
          aria-hidden="true">CT</span
        >
        <span class="sr-only">Home</span>
        <span class="text-base font-semibold tracking-tight text-ink">Chris Tulsi</span>
      </a>
      <button
        id="mobile-menu-toggle"
        class="mobile-menu-toggle z-[1001] flex flex-col gap-1 p-2 md:hidden"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        <span class="h-0.5 w-6 rounded bg-ink transition-all duration-300"></span>
        <span class="h-0.5 w-6 rounded bg-ink transition-all duration-300"></span>
        <span class="h-0.5 w-6 rounded bg-ink transition-all duration-300"></span>
      </button>
      <!-- Mobile drawer backdrop: dims the page and closes the menu on click. -->
      <div
        id="nav-backdrop"
        class="fixed inset-0 z-40 bg-black/60 opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"
        aria-hidden="true"
      >
      </div>
      <div
        class="nav-right fixed md:static top-0 -right-full md:right-auto h-screen md:h-auto w-[78%] max-w-[360px] md:w-auto md:max-w-none z-50 md:z-auto bg-canvas md:bg-transparent flex flex-col md:flex-row items-start md:items-center gap-6 pt-24 md:pt-0 px-8 md:px-0 transition-[right] duration-300 shadow-2xl md:shadow-none rounded-l-2xl md:rounded-none border-l border-hairline/10 md:border-0"
        id="nav-menu"
      >
        <ul
          class="flex w-full flex-col gap-6 font-mono text-sm md:w-auto md:flex-row md:items-center md:gap-7"
        >
          {
            navLinks.map((link, i) => (
              <li>
                <a
                  href={link.href}
                  class="nav-link group flex items-center gap-2 text-ink transition-colors hover:text-primary"
                >
                  <span class="text-xs text-primary">0{i + 1}</span>
                  <span class="nav-link-label">{link.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <div class="flex items-center gap-3 md:ml-2">
          <button
            id="theme-toggle"
            class="mt-auto flex h-10 w-10 items-center justify-center rounded-md border border-hairline/20 text-ink transition-all hover:border-primary hover:text-primary md:mt-0"
            aria-label="Toggle dark mode"
          >
            <Icon name="heroicons:sun-20-solid" class="sun-icon hidden h-5 w-5 dark:block" />
            <Icon name="heroicons:moon-20-solid" class="moon-icon block h-5 w-5 dark:hidden" />
          </button>
        </div>
      </div>
    </div>
  </nav>
</header>

<style>
  /* Animated underline that grows from the left on hover/focus. */
  .nav-link-label {
    position: relative;
  }
  .nav-link-label::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -3px;
    height: 1px;
    width: 100%;
    transform: scaleX(0);
    transform-origin: left;
    background: rgb(var(--accent));
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .nav-link:hover .nav-link-label::after,
  .nav-link:focus-visible .nav-link-label::after {
    transform: scaleX(1);
  }
</style>

<script>
  import { toggleTheme } from '@utils/theme';

  // Module-scoped so document-level listeners bind only once, even though
  // setupHeader re-runs on every ClientRouter navigation.
  let headerKeydownBound = false;

  function setMenuOpen(toggle: HTMLElement, menu: HTMLElement | null, open: boolean) {
    const spans = toggle.querySelectorAll('span');
    spans[0]?.classList.toggle('!rotate-45', open);
    spans[0]?.classList.toggle('!translate-y-1.5', open);
    spans[1]?.classList.toggle('!opacity-0', open);
    spans[2]?.classList.toggle('!-rotate-45', open);
    spans[2]?.classList.toggle('!-translate-y-1.5', open);
    menu?.classList.toggle('!right-0', open);
    const backdrop = document.getElementById('nav-backdrop');
    backdrop?.classList.toggle('!opacity-100', open);
    backdrop?.classList.toggle('!pointer-events-auto', open);
    document.body.classList.toggle('overflow-hidden', open);
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  }

  function setupHeader() {
    const themeToggle = document.getElementById('theme-toggle');
    const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
    const navMenu = document.getElementById('nav-menu');
    const navBackdrop = document.getElementById('nav-backdrop');

    themeToggle?.addEventListener('click', () => toggleTheme());

    mobileMenuToggle?.addEventListener('click', () => {
      const open = mobileMenuToggle.getAttribute('aria-expanded') !== 'true';
      setMenuOpen(mobileMenuToggle, navMenu, open);
      // Move focus into the drawer when opening (accessibility).
      if (open) navMenu?.querySelector<HTMLElement>('a')?.focus();
    });

    // Click the dimmed backdrop to close.
    navBackdrop?.addEventListener('click', () => {
      if (mobileMenuToggle) setMenuOpen(mobileMenuToggle, navMenu, false);
    });

    // Escape to close + a simple focus trap while the drawer is open. Bound once
    // on document (which persists across navigations) and re-queries the DOM.
    if (!headerKeydownBound) {
      headerKeydownBound = true;
      document.addEventListener('keydown', (ev) => {
        const toggle = document.getElementById('mobile-menu-toggle');
        const menu = document.getElementById('nav-menu');
        if (!toggle || toggle.getAttribute('aria-expanded') !== 'true') return;

        if (ev.key === 'Escape') {
          setMenuOpen(toggle, menu, false);
          toggle.focus();
          return;
        }
        if (ev.key === 'Tab' && menu) {
          const focusables = [toggle, ...menu.querySelectorAll<HTMLElement>('a, button')];
          const first = focusables[0];
          const last = focusables[focusables.length - 1];
          if (!first || !last) return;
          if (ev.shiftKey && document.activeElement === first) {
            ev.preventDefault();
            last.focus();
          } else if (!ev.shiftKey && document.activeElement === last) {
            ev.preventDefault();
            first.focus();
          }
        }
      });
    }

    // Close menu when clicking an in-page anchor link, and smooth-scroll if we're on the same page.
    document.querySelectorAll<HTMLAnchorElement>('a[href*="#"]').forEach((link) => {
      link.addEventListener('click', (ev) => {
        if (mobileMenuToggle) setMenuOpen(mobileMenuToggle, navMenu, false);

        const href = link.getAttribute('href') || '';
        const base = import.meta.env.BASE_URL ?? '/';
        const normalizedBase = base.replace(/\/$/, '');
        if (href.startsWith(normalizedBase + '#') || href.startsWith(base + '#')) {
          const currentPath = location.pathname.replace(/\/$/, '');
          if (currentPath === normalizedBase || currentPath === '' || currentPath === '/') {
            ev.preventDefault();
            const hash = href.split('#')[1];
            const target = hash ? document.getElementById(hash) : null;
            if (target) {
              target.scrollIntoView({ behavior: 'smooth' });
              history.replaceState(null, '', '#' + hash);
            }
          }
        }
      });
    });
  }

  document.addEventListener('astro:page-load', setupHeader);
</script>
