---
import { Icon } from 'astro-icon/components';

const base = import.meta.env.BASE_URL ?? '/';
---

<header class="sticky top-0 bg-white/95 dark:bg-gray-900/95 shadow-sm z-[1000] transition-colors">
  <nav class="container py-3 md:py-4">
    <div class="flex justify-between items-center">
      <a
        href={base}
        class="flex items-center gap-3 text-2xl font-extrabold text-primary tracking-tight"
      >
        <span
          class="inline-block w-10 h-10 rounded-lg bg-gradient-to-br from-primary to-secondary flex items-center justify-center text-white shadow"
          >CT</span
        >
        <span class="sr-only">Home</span>
        <span class="ml-1">Chris Tulsi</span>
      </a>
      <button
        id="mobile-menu-toggle"
        class="mobile-menu-toggle md:hidden flex flex-col gap-1 p-2 z-[1001]"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        <span class="w-6 h-0.5 bg-gray-900 dark:bg-gray-50 transition-all duration-300 rounded"
        ></span>
        <span class="w-6 h-0.5 bg-gray-900 dark:bg-gray-50 transition-all duration-300 rounded"
        ></span>
        <span class="w-6 h-0.5 bg-gray-900 dark:bg-gray-50 transition-all duration-300 rounded"
        ></span>
      </button>
      <!-- Mobile drawer backdrop: dims the page and closes the menu on click. -->
      <div
        id="nav-backdrop"
        class="fixed inset-0 z-40 bg-black/50 opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"
        aria-hidden="true"
      >
      </div>
      <div
        class="nav-right fixed md:static top-0 -right-full md:right-auto h-screen md:h-auto w-[78%] max-w-[360px] md:w-auto md:max-w-none z-50 md:z-auto bg-white dark:bg-gray-900 md:bg-transparent flex flex-col md:flex-row items-start md:items-center gap-6 pt-24 md:pt-0 px-8 md:px-0 transition-[right] duration-300 shadow-2xl md:shadow-none rounded-l-2xl md:rounded-none"
        id="nav-menu"
      >
        <ul class="flex flex-col md:flex-row gap-6 md:gap-8 w-full md:w-auto">
          <li>
            <a
              href={`${base}#about`}
              class="text-gray-900 dark:text-gray-50 hover:text-primary font-medium transition-colors block text-lg md:text-base"
              >About</a
            >
          </li>
          <li>
            <a
              href={`${base}#projects`}
              class="text-gray-900 dark:text-gray-50 hover:text-primary font-medium transition-colors block text-lg md:text-base"
              >Projects</a
            >
          </li>
          <li>
            <a
              href={`${base}#experience`}
              class="text-gray-900 dark:text-gray-50 hover:text-primary font-medium transition-colors block text-lg md:text-base"
              >Experience</a
            >
          </li>
          <li>
            <a
              href={`${base}#contact`}
              class="text-gray-900 dark:text-gray-50 hover:text-primary font-medium transition-colors block text-lg md:text-base"
              >Contact</a
            >
          </li>
        </ul>
        <div class="flex items-center gap-3">
          <button
            id="theme-toggle"
            class="mt-auto md:mt-0 w-10 h-10 border-2 border-gray-200 dark:border-gray-700 rounded-full flex items-center justify-center hover:bg-gray-100 dark:hover:bg-gray-800 hover:border-primary transition-all shadow-sm"
            aria-label="Toggle dark mode"
          >
            <Icon name="heroicons:sun-20-solid" class="sun-icon hidden dark:block w-5 h-5" />
            <Icon name="heroicons:moon-20-solid" class="moon-icon block dark:hidden w-5 h-5" />
          </button>
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  import { toggleTheme } from '@utils/theme';

  // Module-scoped so document-level listeners bind only once, even though
  // setupHeader re-runs on every ClientRouter navigation.
  let headerKeydownBound = false;

  function setMenuOpen(toggle: HTMLElement, menu: HTMLElement | null, open: boolean) {
    const spans = toggle.querySelectorAll('span');
    spans[0]?.classList.toggle('!rotate-45', open);
    spans[0]?.classList.toggle('!translate-y-1.5', open);
    spans[1]?.classList.toggle('!opacity-0', open);
    spans[2]?.classList.toggle('!-rotate-45', open);
    spans[2]?.classList.toggle('!-translate-y-1.5', open);
    menu?.classList.toggle('!right-0', open);
    const backdrop = document.getElementById('nav-backdrop');
    backdrop?.classList.toggle('!opacity-100', open);
    backdrop?.classList.toggle('!pointer-events-auto', open);
    document.body.classList.toggle('overflow-hidden', open);
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  }

  function setupHeader() {
    const themeToggle = document.getElementById('theme-toggle');
    const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
    const navMenu = document.getElementById('nav-menu');
    const navBackdrop = document.getElementById('nav-backdrop');

    themeToggle?.addEventListener('click', () => toggleTheme());

    mobileMenuToggle?.addEventListener('click', () => {
      const open = mobileMenuToggle.getAttribute('aria-expanded') !== 'true';
      setMenuOpen(mobileMenuToggle, navMenu, open);
      // Move focus into the drawer when opening (accessibility).
      if (open) navMenu?.querySelector<HTMLElement>('a')?.focus();
    });

    // Click the dimmed backdrop to close.
    navBackdrop?.addEventListener('click', () => {
      if (mobileMenuToggle) setMenuOpen(mobileMenuToggle, navMenu, false);
    });

    // Escape to close + a simple focus trap while the drawer is open. Bound once
    // on document (which persists across navigations) and re-queries the DOM.
    if (!headerKeydownBound) {
      headerKeydownBound = true;
      document.addEventListener('keydown', (ev) => {
        const toggle = document.getElementById('mobile-menu-toggle');
        const menu = document.getElementById('nav-menu');
        if (!toggle || toggle.getAttribute('aria-expanded') !== 'true') return;

        if (ev.key === 'Escape') {
          setMenuOpen(toggle, menu, false);
          toggle.focus();
          return;
        }
        if (ev.key === 'Tab' && menu) {
          const focusables = [toggle, ...menu.querySelectorAll<HTMLElement>('a, button')];
          const first = focusables[0];
          const last = focusables[focusables.length - 1];
          if (!first || !last) return;
          if (ev.shiftKey && document.activeElement === first) {
            ev.preventDefault();
            last.focus();
          } else if (!ev.shiftKey && document.activeElement === last) {
            ev.preventDefault();
            first.focus();
          }
        }
      });
    }

    // Close menu when clicking an in-page anchor link, and smooth-scroll if we're on the same page.
    document.querySelectorAll<HTMLAnchorElement>('a[href*="#"]').forEach((link) => {
      link.addEventListener('click', (ev) => {
        if (mobileMenuToggle) setMenuOpen(mobileMenuToggle, navMenu, false);

        const href = link.getAttribute('href') || '';
        const base = import.meta.env.BASE_URL ?? '/';
        const normalizedBase = base.replace(/\/$/, '');
        if (href.startsWith(normalizedBase + '#') || href.startsWith(base + '#')) {
          const currentPath = location.pathname.replace(/\/$/, '');
          if (currentPath === normalizedBase || currentPath === '' || currentPath === '/') {
            ev.preventDefault();
            const hash = href.split('#')[1];
            const target = hash ? document.getElementById(hash) : null;
            if (target) {
              target.scrollIntoView({ behavior: 'smooth' });
              history.replaceState(null, '', '#' + hash);
            }
          }
        }
      });
    });
  }

  document.addEventListener('astro:page-load', setupHeader);
</script>
