---
import { Icon } from 'astro-icon/components';

const base = import.meta.env.BASE_URL ?? '/';

const links = [
  { id: 'projects', label: 'Projects' },
  { id: 'about', label: 'About' },
  { id: 'experience', label: 'Experience' },
  { id: 'contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-[1000] border-b border-line/70 bg-canvas/95 transition-colors">
  <!-- No backdrop-filter here: it would become the containing block for the
       fixed-position mobile drawer and backdrop below. -->
  <nav class="page-width flex h-16 items-center gap-2 md:h-20 md:gap-6" aria-label="Primary">
    <a href={base} class="mr-auto flex items-center gap-3 text-ink no-underline">
      <svg viewBox="0 0 32 32" class="h-8 w-8 shrink-0" aria-hidden="true" focusable="false">
        <rect width="32" height="32" rx="9" fill="#0c4a34"></rect>
        <path d="M9 8.5 24.5 16 9 23.5Z" fill="#f4c430" stroke="#ecf5ef" stroke-width="1.5"></path>
      </svg>
      <span class="font-display text-lg tracking-tight">Chris Tulsi</span>
    </a>
    <!-- Mobile drawer backdrop: dims the page and closes the menu on click. -->
    <div
      id="nav-backdrop"
      class="pointer-events-none fixed inset-0 z-40 bg-black/50 opacity-0 transition-opacity duration-300 md:hidden"
      aria-hidden="true"
    ></div>
    <div
      class="nav-right invisible fixed -right-full top-0 z-50 flex h-screen w-[80%] max-w-[360px] flex-col items-start gap-8 rounded-l-tile bg-surface px-8 pt-24 shadow-2xl transition-[right,visibility] duration-300 md:visible md:static md:right-auto md:z-auto md:h-auto md:w-auto md:max-w-none md:flex-row md:items-center md:gap-6 md:rounded-none md:bg-transparent md:px-0 md:pt-0 md:shadow-none"
      id="nav-menu"
    >
      <ul class="flex w-full flex-col gap-5 md:w-auto md:flex-row md:items-center md:gap-1">
        {links.map((link) => (
          <li>
            <a
              href={`${base}#${link.id}`}
              data-magnetic={link.id === 'contact' ? '' : undefined}
              class:list={[
                'block font-heading text-3xl text-ink no-underline md:text-[0.95rem] md:leading-9 md:font-semibold md:tracking-normal md:[font-stretch:100%]',
                link.id === 'contact'
                  ? 'md:ml-2 md:rounded-full md:bg-gold md:px-5 md:py-2.5 md:text-on-gold md:hover:bg-gold/85'
                  : 'hover:text-link md:rounded-full md:px-4 md:py-2.5 md:hover:bg-sunken md:hover:text-ink',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <button
      id="theme-toggle"
      class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-line text-ink transition-colors hover:bg-sunken"
      aria-label="Toggle dark mode"
    >
      <Icon name="heroicons:sun-20-solid" class="sun-icon hidden h-5 w-5 dark:block" />
      <Icon name="heroicons:moon-20-solid" class="moon-icon block h-5 w-5 dark:hidden" />
    </button>
    <button
      id="mobile-menu-toggle"
      class="mobile-menu-toggle z-[1001] flex h-11 w-11 flex-col items-center justify-center gap-1.5 rounded-full border border-line md:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <span class="h-0.5 w-5 rounded bg-ink transition-all duration-300"></span>
      <span class="h-0.5 w-5 rounded bg-ink transition-all duration-300"></span>
      <span class="h-0.5 w-5 rounded bg-ink transition-all duration-300"></span>
    </button>
  </nav>
</header>

<script>
  import { toggleTheme } from '@utils/theme';

  import { scrollToTarget } from '../scripts/motion/scroll-to';

  // Module-scoped so document-level listeners bind only once, even though
  // setupHeader re-runs on every ClientRouter navigation.
  let headerKeydownBound = false;

  function setMenuOpen(toggle: HTMLElement, menu: HTMLElement | null, open: boolean) {
    const spans = toggle.querySelectorAll('span');
    spans[0]?.classList.toggle('!rotate-45', open);
    spans[0]?.classList.toggle('!translate-y-1.5', open);
    spans[1]?.classList.toggle('!opacity-0', open);
    spans[2]?.classList.toggle('!-rotate-45', open);
    spans[2]?.classList.toggle('!-translate-y-1.5', open);
    menu?.classList.toggle('!right-0', open);
    // Closed drawer is visibility:hidden so its off-screen links leave the tab order.
    menu?.classList.toggle('!visible', open);
    const backdrop = document.getElementById('nav-backdrop');
    backdrop?.classList.toggle('!opacity-100', open);
    backdrop?.classList.toggle('!pointer-events-auto', open);
    document.body.classList.toggle('overflow-hidden', open);
    // NEW: smooth scrolling ignores body overflow, so pause it explicitly.
    window.dispatchEvent(new CustomEvent('scroll:lock', { detail: open }));
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  }

  function setupHeader() {
    const themeToggle = document.getElementById('theme-toggle');
    const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
    const navMenu = document.getElementById('nav-menu');
    const navBackdrop = document.getElementById('nav-backdrop');

    themeToggle?.addEventListener('click', () => toggleTheme());

    mobileMenuToggle?.addEventListener('click', () => {
      const open = mobileMenuToggle.getAttribute('aria-expanded') !== 'true';
      setMenuOpen(mobileMenuToggle, navMenu, open);
      // Move focus into the drawer when opening (accessibility).
      if (open) navMenu?.querySelector<HTMLElement>('a')?.focus();
    });

    // Click the dimmed backdrop to close.
    navBackdrop?.addEventListener('click', () => {
      if (mobileMenuToggle) setMenuOpen(mobileMenuToggle, navMenu, false);
    });

    // Escape to close + a simple focus trap while the drawer is open. Bound once
    // on document (which persists across navigations) and re-queries the DOM.
    if (!headerKeydownBound) {
      headerKeydownBound = true;
      document.addEventListener('keydown', (ev) => {
        const toggle = document.getElementById('mobile-menu-toggle');
        const menu = document.getElementById('nav-menu');
        if (!toggle || toggle.getAttribute('aria-expanded') !== 'true') return;

        if (ev.key === 'Escape') {
          setMenuOpen(toggle, menu, false);
          toggle.focus();
          return;
        }
        if (ev.key === 'Tab' && menu) {
          const focusables = [toggle, ...menu.querySelectorAll<HTMLElement>('a, button')];
          const first = focusables[0];
          const last = focusables[focusables.length - 1];
          if (!first || !last) return;
          if (ev.shiftKey && document.activeElement === first) {
            ev.preventDefault();
            last.focus();
          } else if (!ev.shiftKey && document.activeElement === last) {
            ev.preventDefault();
            first.focus();
          }
        }
      });
    }

    // Close menu when clicking an in-page anchor link, and smooth-scroll if we're on the same page.
    document.querySelectorAll<HTMLAnchorElement>('a[href*="#"]').forEach((link) => {
      link.addEventListener('click', (ev) => {
        if (mobileMenuToggle) setMenuOpen(mobileMenuToggle, navMenu, false);

        const href = link.getAttribute('href') || '';
        const base = import.meta.env.BASE_URL ?? '/';
        const normalizedBase = base.replace(/\/$/, '');
        if (href.startsWith(normalizedBase + '#') || href.startsWith(base + '#')) {
          const currentPath = location.pathname.replace(/\/$/, '');
          if (currentPath === normalizedBase || currentPath === '' || currentPath === '/') {
            ev.preventDefault();
            const hash = href.split('#')[1];
            const target = hash ? document.getElementById(hash) : null;
            if (target) {
              // NEW: Lenis-aware (falls back to native smooth scrolling).
              scrollToTarget(target);
              history.replaceState(null, '', '#' + hash);
            }
          }
        }
      });
    });
  }

  document.addEventListener('astro:page-load', setupHeader);
</script>
