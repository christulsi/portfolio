---
const stats = [
  { number: '10+', label: 'Applications Built', unit: 'apps' },
  { number: '6+', label: 'Years Experience', unit: 'yrs' },
  { number: '5+', label: 'Major Projects', unit: 'proj' },
  { number: '99.9%', label: 'System Uptime', unit: 'sla' },
];
---

<section class="relative border-y border-hairline/10 bg-surface/30 py-16 backdrop-blur-xs">
  <div class="container">
    <div class="grid grid-cols-2 gap-px overflow-hidden md:grid-cols-4">
      {
        stats.map((stat) => (
          <div class="fade-in relative px-4 py-6 text-center md:px-6">
            <span class="font-mono text-[0.65rem] uppercase tracking-[0.28em] text-muted">
              {stat.unit}
            </span>
            <div
              class="stat-number mt-3 font-mono text-4xl font-bold leading-none text-primary md:text-5xl"
              data-target={stat.number}
            >
              {stat.number}
            </div>
            <div class="mt-3 text-sm font-medium text-muted">{stat.label}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  const animateValue = (
    element: HTMLElement,
    start: number,
    end: number,
    duration: number,
    suffix = '',
    decimals = 0
  ) => {
    const range = end - start;
    const startTime = performance.now();
    const format = (v: number) => (decimals > 0 ? v.toFixed(decimals) : Math.round(v).toString());

    const tick = (now: number) => {
      const t = Math.min(1, (now - startTime) / duration);
      // Ease-out cubic for a snappier finish
      const eased = 1 - Math.pow(1 - t, 3);
      element.textContent = format(start + range * eased) + suffix;
      if (t < 1) requestAnimationFrame(tick);
      else element.textContent = format(end) + suffix;
    };
    requestAnimationFrame(tick);
  };

  const setupStats = () => {
    const statNumbers = document.querySelectorAll('.stat-number');
    if (!statNumbers.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !entry.target.classList.contains('animated')) {
            entry.target.classList.add('animated');
            const target = entry.target.getAttribute('data-target') || '0';
            const numericMatch = target.match(/[0-9]+(?:\.[0-9]+)?/);
            const numValue = numericMatch ? parseFloat(numericMatch[0]) : 0;
            const suffix = target.includes('+') ? '+' : target.includes('%') ? '%' : '';
            const decimalPart = numericMatch?.[0].split('.')[1];
            const decimals = decimalPart ? Math.min(2, decimalPart.length) : 0;
            animateValue(entry.target as HTMLElement, 0, numValue, 2000, suffix, decimals);
          }
        });
      },
      { threshold: 0.5 }
    );
    statNumbers.forEach((stat) => observer.observe(stat));
  };

  // Re-runs on every client-side navigation
  document.addEventListener('astro:page-load', setupStats);
</script>
