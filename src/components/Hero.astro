---
import { getCollection } from 'astro:content';

import { findCurrent, periodStart } from '../utils/content';

const base = import.meta.env.BASE_URL ?? '/';

const experiences = (await getCollection('experiences')).map((entry) => entry.data);
const current = findCurrent(experiences);

const figures = [
  { value: '6+', label: 'years building public-sector systems' },
  { value: '10+', label: 'web and mobile apps shipped' },
  { value: '5+', label: 'transformation projects led' },
  { value: '99.9%', label: 'uptime on the systems I run' },
];
---

<section class="container pb-4 pt-4 md:pt-6" aria-labelledby="hero-title">
  <div class="grid gap-3 md:grid-cols-2 md:gap-4 lg:grid-cols-12">
    <div
      class="rise tile tile-surface flex flex-col justify-between gap-8 md:col-span-2 md:p-10 lg:col-span-8 lg:row-span-2"
      style="--i: 0"
    >
      <p
        class="inline-flex w-fit items-center gap-2 rounded-full bg-sunken px-3.5 py-1.5 text-sm font-medium"
      >
        <span class="h-2 w-2 rounded-full bg-[#1f8a5b]" aria-hidden="true"></span>
        Open to new opportunities
      </p>
      <div>
        <h1 id="hero-title" class="hero-name font-display">
          <span class="block">Chris</span>
          <span class="block">Tulsi</span>
        </h1>
        <p class="mt-6 max-w-[34rem] text-lg text-muted md:text-xl">
          I design, build and run the software behind public services in Guyana: ERP rollouts,
          application platforms, and the pipelines that ship them.
        </p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a href={`${base}#projects`} class="btn btn-gold">See selected work</a>
        <a href={`${base}#contact`} class="btn btn-ghost">Get in touch</a>
      </div>
    </div>

    {
      current && (
        <div
          class="rise tile tile-gold flex flex-col justify-between gap-8 lg:col-span-4"
          style="--i: 1"
        >
          <p class="text-sm font-medium">Since {periodStart(current.period)}</p>
          <p class="text-2xl font-semibold leading-snug md:text-[1.7rem]">
            {current.title}
            <span class="block font-normal">{current.company}</span>
          </p>
        </div>
      )
    }

    <div
      class="rise tile tile-forest flex flex-col justify-between gap-8 lg:col-span-4"
      style="--i: 2"
    >
      <p class="text-sm font-medium text-on-forest/80">Local time in Guyana</p>
      <p class="font-heading text-5xl tabular-nums md:text-6xl">
        <time id="gy-clock" data-tz="America/Guyana">GMT−4</time>
      </p>
    </div>

    <dl
      class="rise tile tile-sunken grid grid-cols-2 gap-x-6 gap-y-6 md:col-span-2 md:grid-cols-4 md:py-7 lg:col-span-12"
      style="--i: 3"
    >
      {
        figures.map((figure) => (
          <div class="flex flex-col-reverse gap-1 md:border-l md:border-line md:pl-6 md:first:border-l-0 md:first:pl-0">
            <dt class="text-sm text-muted">{figure.label}</dt>
            <dd class="font-heading text-3xl md:text-4xl">{figure.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero-name {
    font-size: clamp(4.25rem, 22vw, 10rem);
    line-height: 0.86;
    letter-spacing: -0.04em;
  }

  @media (min-width: 1024px) {
    .hero-name {
      font-size: clamp(6rem, 10vw, 9.25rem);
    }
  }
</style>

<script>
  // Live local time in Guyana. The static HTML shows the UTC offset, so the
  // tile still reads correctly without JavaScript.
  let clockTimer: number | undefined;

  function startClock() {
    const el = document.getElementById('gy-clock');
    if (!el) return;
    const format = new Intl.DateTimeFormat('en-GB', {
      hour: '2-digit',
      minute: '2-digit',
      timeZone: el.dataset.tz,
    });
    const tick = () => {
      const now = new Date();
      el.textContent = format.format(now);
      el.setAttribute('datetime', now.toISOString());
    };
    tick();
    window.clearInterval(clockTimer);
    clockTimer = window.setInterval(tick, 15_000);
  }

  document.addEventListener('astro:page-load', startClock);
</script>
