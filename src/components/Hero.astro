---
import { getCollection } from 'astro:content';

import { findCurrent, periodStart } from '../utils/content';

const base = import.meta.env.BASE_URL ?? '/';

const experiences = (await getCollection('experiences')).map((entry) => entry.data);
const current = findCurrent(experiences);

const figures = [
  { value: '6+', label: 'years building public-sector systems' },
  { value: '10+', label: 'web and mobile apps shipped' },
  { value: '5+', label: 'transformation projects led' },
  { value: '99.9%', label: 'uptime on the systems I run' },
];
---

<!--
  NEW: Full-screen hero. The name sits on open canvas with the 3D particle
  arrowhead (three.js, in the fixed background canvas) to its right; the
  current role, local time and key figures form a bento strip along the
  bottom. `data-hero-scene` tells the motion layer to drive the 3D scene from
  this section's scroll position; `data-intro-item` and `.hero-line` are
  choreographed by the intro (src/scripts/motion/intro.ts).
-->
<section class="hero" data-hero-scene aria-labelledby="hero-title">
  <div class="container flex min-h-[calc(100svh-4rem)] flex-col justify-between gap-10 pb-4 pt-8 md:min-h-[calc(100svh-5rem)] md:gap-12 md:pt-10">
    <div class="max-w-[46rem]">
      <p
        data-intro-item
        class="inline-flex w-fit items-center gap-2 rounded-full border border-line bg-surface/70 px-3.5 py-1.5 text-sm font-medium"
      >
        <span class="h-2 w-2 rounded-full bg-[#1f8a5b]" aria-hidden="true"></span>
        Open to new opportunities
      </p>
      <h1 id="hero-title" class="hero-name font-display mt-8">
        <span class="hero-line">
          <span>Chris</span>
        </span>
        <span class="hero-line">
          <span>Tulsi</span>
        </span>
      </h1>
      <p data-intro-item class="lede mt-6 max-w-[38rem] text-muted md:mt-8 xl:max-w-[44rem]">
        I design, build and run the software behind public services in Guyana: ERP rollouts,
        application platforms, and the pipelines that ship them.
      </p>
      <div data-intro-item class="mt-8 flex flex-col gap-3 sm:flex-row">
        <!-- NEW: magnetic CTAs (fine pointers only). -->
        <a href={`${base}#projects`} class="btn btn-gold" data-magnetic>
          See selected work
        </a>
        <a href={`${base}#contact`} class="btn btn-ghost bg-canvas/60" data-magnetic>
          Get in touch
        </a>
      </div>
    </div>

    <div class="grid gap-3 sm:grid-cols-2 md:gap-4 lg:grid-cols-12">
      {current && (
        <div
          data-intro-item
          class="tile tile-gold flex flex-col justify-between gap-4 md:p-6 lg:col-span-4 xl:col-span-3"
        >
          <p class="text-sm font-medium">Since {periodStart(current.period)}</p>
          <p class="text-xl font-semibold leading-snug">
            {current.title}
            <span class="block font-normal">{current.company}</span>
          </p>
        </div>
      )}

      <div
        data-intro-item
        class="tile tile-forest flex flex-col justify-between gap-4 md:p-6 lg:col-span-3 xl:col-span-2"
      >
        <p class="text-sm font-medium text-on-forest/80">Local time in Guyana</p>
        <p class="font-heading text-4xl tabular-nums md:text-5xl">
          <time id="gy-clock" data-tz="America/Guyana">
            GMT−4
          </time>
        </p>
      </div>

      <dl
        data-intro-item
        class="tile tile-sunken grid grid-cols-2 gap-x-6 gap-y-4 sm:col-span-2 md:p-6 lg:col-span-5 xl:col-span-7 xl:grid-cols-4"
      >
        {figures.map((figure) => (
          <div class="flex flex-col-reverse justify-end gap-0.5">
            <dt class="text-sm text-muted">{figure.label}</dt>
            <dd class="font-heading text-2xl md:text-3xl">{figure.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  /* NEW: bigger, tighter name. Each line is a mask its text rises out of. */
  .hero-name {
    font-size: clamp(4.5rem, 21vw, 11rem);
    line-height: 0.84;
    letter-spacing: -0.045em;
  }

  @media (min-width: 768px) {
    .hero-name {
      font-size: clamp(5rem, min(10.5vw, 15vh), 10rem);
    }
  }

  .hero-line {
    display: block;
    overflow: hidden;
    padding-block: 0.12em 0.04em;
    margin-block: -0.12em -0.04em;
  }

  .hero-line > span {
    display: inline-block;
  }
</style>

<script>
  // Live local time in Guyana. The static HTML shows the UTC offset, so the
  // tile still reads correctly without JavaScript.
  let clockTimer: number | undefined;

  function startClock() {
    const el = document.getElementById('gy-clock');
    if (!el) return;
    const format = new Intl.DateTimeFormat('en-GB', {
      hour: '2-digit',
      minute: '2-digit',
      timeZone: el.dataset.tz,
    });
    const tick = () => {
      const now = new Date();
      el.textContent = format.format(now);
      el.setAttribute('datetime', now.toISOString());
    };
    tick();
    window.clearInterval(clockTimer);
    clockTimer = window.setInterval(tick, 15_000);
  }

  document.addEventListener('astro:page-load', startClock);
</script>
