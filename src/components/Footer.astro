---
import { Icon } from 'astro-icon/components';

const currentYear = new Date().getFullYear();
const base = import.meta.env.BASE_URL ?? '/';

const socials = [
  {
    label: 'GitHub',
    href: 'https://github.com/christulsi',
    path: 'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23a11.51 11.51 0 0 1 3.003-.404c1.018.005 2.045.138 3.003.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.91 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222 0 1.606-.014 2.898-.014 3.293 0 .322.216.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
  },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/chris-tulsi/',
    path: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z',
  },
];

const quickLinks = [
  { href: `${base}#about`, label: 'About' },
  { href: `${base}#projects`, label: 'Projects' },
  { href: `${base}#experience`, label: 'Experience' },
  { href: `${base}#contact`, label: 'Contact' },
];

const builtWith = [
  { href: 'https://astro.build', label: 'Astro' },
  { href: 'https://www.typescriptlang.org/', label: 'TypeScript' },
  { href: 'https://tailwindcss.com', label: 'Tailwind CSS' },
];
---

<footer class="relative border-t border-hairline/10 bg-[rgb(var(--bg-2))] pb-8 pt-16">
  <div class="container">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr_1fr]">
      <div>
        <div class="flex items-center gap-3 font-mono">
          <span
            class="flex h-9 w-9 items-center justify-center rounded-md border border-primary/60 text-sm font-bold text-primary"
            aria-hidden="true">CT</span
          >
          <span class="text-base font-semibold text-ink">Chris Tulsi</span>
        </div>
        <p class="mt-5 max-w-xs leading-relaxed text-muted">
          Senior ICT Engineer delivering robust, scalable solutions for government and enterprise.
        </p>
        <div class="mt-6 flex gap-3">
          {
            socials.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.label}
                class="flex h-10 w-10 items-center justify-center rounded-md border border-hairline/15 text-muted transition-all hover:-translate-y-0.5 hover:border-primary/50 hover:text-primary"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
                  <path d={s.path} />
                </svg>
              </a>
            ))
          }
          <a
            href="mailto:christulsi@gmail.com"
            aria-label="Email"
            class="flex h-10 w-10 items-center justify-center rounded-md border border-hairline/15 text-muted transition-all hover:-translate-y-0.5 hover:border-primary/50 hover:text-primary"
          >
            <Icon name="heroicons:envelope-20-solid" class="h-5 w-5" />
          </a>
        </div>
      </div>

      <div>
        <h4 class="font-mono text-xs uppercase tracking-[0.28em] text-muted">Navigate</h4>
        <ul class="mt-5 space-y-3">
          {
            quickLinks.map((link) => (
              <li>
                <a href={link.href} class="text-muted transition-colors hover:text-primary">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h4 class="font-mono text-xs uppercase tracking-[0.28em] text-muted">Contact</h4>
        <ul class="mt-5 space-y-3">
          <li>
            <a href={`${base}#contact`} class="text-muted transition-colors hover:text-primary"
              >Get in Touch</a
            >
          </li>
          <li>
            <a
              href="mailto:christulsi@gmail.com"
              class="text-muted transition-colors hover:text-primary">Email Me</a
            >
          </li>
          <li>
            <a
              href="https://github.com/christulsi"
              target="_blank"
              rel="noopener noreferrer"
              class="text-muted transition-colors hover:text-primary">GitHub</a
            >
          </li>
        </ul>
      </div>

      <div>
        <h4 class="font-mono text-xs uppercase tracking-[0.28em] text-muted">Built With</h4>
        <ul class="mt-5 space-y-3">
          {
            builtWith.map((item) => (
              <li>
                <a
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-muted transition-colors hover:text-primary"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="flex flex-col items-center justify-between gap-2 border-t border-hairline/10 pt-8 text-center font-mono text-xs text-muted md:flex-row md:text-left"
    >
      <p>&copy; {currentYear} Chris Tulsi — all rights reserved.</p>
      <p>Designed &amp; built with Astro &amp; Tailwind CSS.</p>
    </div>
  </div>
</footer>
