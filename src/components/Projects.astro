---
import { getCollection } from 'astro:content';

import { sortByOrder } from '../utils/content';

import ProjectCard from './ProjectCard.astro';

// NEW: keep each entry's id as its slug (detail-page URL).
const projects = sortByOrder(
  (await getCollection('projects')).map((entry) => ({ ...entry.data, slug: entry.id }))
);

// Alternating wide/narrow tiles give the grid a bento rhythm; the lead project
// gets the forest treatment.
const layout = [
  { variant: 'forest', span: 'lg:col-span-7' },
  { variant: 'surface', span: 'lg:col-span-5' },
  { variant: 'surface', span: 'lg:col-span-5' },
  { variant: 'sunken', span: 'lg:col-span-7' },
] as const;
---

<section id="projects" class="section container" aria-labelledby="projects-title">
  <div class="section-head">
    <h2 id="projects-title" class="section-title" data-reveal="title">
      Selected work
    </h2>
    <p class="section-intro" data-reveal="fade">
      Systems for government agencies in Guyana, and the tooling that keeps them shipping.
    </p>
  </div>

  <!-- NEW: `tilt-stage` gives the cards perspective; `data-reveal` staggers them in. -->
  <div class="tilt-stage grid gap-3 md:gap-4 lg:grid-cols-12" data-reveal="stagger">
    {projects.map((project, index) => {
      const slot = layout[index % layout.length] ?? layout[1];
      return <ProjectCard {...project} variant={slot.variant} class={slot.span} />;
    })}
  </div>
</section>
