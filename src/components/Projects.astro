---
import { getCollection } from 'astro:content';

import ProjectCard from './ProjectCard.astro';

const projectEntries = await getCollection('projects');
const projects = projectEntries.map((entry) => entry.data);
---

<section id="projects" class="relative bg-transparent py-24">
  <div class="container relative z-10">
    <div class="fade-in mb-14 flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <p class="kicker">
          <span class="text-primary">02</span>&nbsp;&nbsp;/&nbsp;&nbsp;Selected Work
        </p>
        <h2 class="section-title mt-5">Featured Projects</h2>
      </div>
      <p class="font-mono text-sm text-muted">{projects.length} systems shipped</p>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      {
        projects.map((project, index) => (
          <div class="fade-in" style={`transition-delay: ${index * 90}ms;`}>
            <ProjectCard {...project} index={index} />
          </div>
        ))
      }
    </div>
  </div>
</section>
