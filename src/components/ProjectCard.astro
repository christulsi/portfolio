---
interface Props {
  title: string;
  description: string;
  technologies: string[];
  githubUrl?: string;
  liveUrl?: string;
  client?: string;
  outcome?: string;
  /** Tile treatment; the Projects grid alternates these for bento rhythm. */
  variant?: 'forest' | 'surface' | 'sunken';
  class?: string;
}

const {
  title,
  description,
  technologies,
  githubUrl,
  client,
  outcome,
  variant = 'surface',
  class: className,
} = Astro.props;

const onForest = variant === 'forest';
---

<article
  class:list={[
    'tile flex h-full flex-col gap-6',
    {
      'tile-forest': variant === 'forest',
      'tile-surface': variant === 'surface',
      'tile-sunken': variant === 'sunken',
    },
    className,
  ]}
>
  <div class="flex flex-wrap items-center justify-between gap-3 text-sm">
    {client && <p class:list={[onForest ? 'text-on-forest/80' : 'text-muted']}>{client}</p>}
    {outcome && <p class="rounded-full bg-gold px-3 py-1 font-semibold text-on-gold">{outcome}</p>}
  </div>

  <div class="flex-grow">
    <h3 class="font-heading text-[1.65rem] leading-[1.05] md:text-[2rem]">{title}</h3>
    <p class:list={['mt-4 max-w-prose', onForest ? 'text-on-forest/85' : 'text-muted']}>
      {description}
    </p>
  </div>

  <ul class="flex flex-wrap gap-2" aria-label={`Technologies used in ${title}`}>
    {
      technologies.map((tech) => (
        <li class:list={['chip', onForest ? 'border-on-forest/30' : 'border-line bg-surface']}>
          {tech}
        </li>
      ))
    }
  </ul>

  {
    githubUrl && (
      <a
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class:list={['font-semibold underline', onForest && 'text-on-forest']}
      >
        View source on GitHub
      </a>
    )
  }
</article>
