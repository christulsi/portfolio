---
import { getCollection } from 'astro:content';

const skillEntries = await getCollection('skills');
const categories = skillEntries.map((entry) => entry.data);
---

<section id="about" class="relative bg-transparent py-24">
  <div class="container relative z-10">
    <div class="fade-in mb-14 max-w-2xl">
      <p class="kicker"><span class="text-primary">01</span>&nbsp;&nbsp;/&nbsp;&nbsp;About</p>
      <h2 class="section-title mt-5">
        Engineering systems that stay <em class="font-display italic text-primary">up</em>.
      </h2>
    </div>

    <div class="grid gap-14 md:grid-cols-[1fr_1fr] lg:gap-20">
      <div class="fade-in space-y-6 text-lg leading-relaxed text-muted">
        <p>
          With a Master's in Computer Software Engineering from Nankai University and a Bachelor's
          in Computer Science from the University of Guyana, I bring a solid academic foundation to
          my work.
        </p>
        <p>
          As a Senior ICT Engineer at the National Data Management Authority, I've led digital
          transformation initiatives, improved system uptime by 15%, and mentored junior engineers
          to foster continuous learning and growth.
        </p>
        <p>
          I'm driven by optimizing systems, implementing DevOps best practices, and leveraging
          emerging technologies to solve complex business challenges — an AWS Certified Cloud
          Practitioner with full-stack and cloud-infrastructure expertise.
        </p>
      </div>

      <div class="fade-in panel p-8">
        <h3 class="font-mono text-xs uppercase tracking-[0.28em] text-muted">Skills &amp; Stack</h3>
        <div class="mt-8 flex flex-col gap-8">
          {
            categories.map((category, catIndex) => (
              <div>
                <h4 class="flex items-center gap-2 text-sm font-semibold text-ink">
                  <span class="font-mono text-xs text-primary">
                    {String(catIndex + 1).padStart(2, '0')}
                  </span>
                  {category.name}
                </h4>
                <div class="mt-4 flex flex-wrap gap-2.5">
                  {category.skills.map((skill, skillIndex) => (
                    <span
                      class="skill-tag animate-fade-in-up"
                      style={`animation-delay: ${(catIndex * 6 + skillIndex) * 70}ms;`}
                    >
                      {skill}
                    </span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
