---
import { getCollection } from 'astro:content';

const skillEntries = await getCollection('skills');
const categories = skillEntries.map((entry) => entry.data);
---

<section id="about" class="section container" aria-labelledby="about-title">
  <div class="section-head">
    <h2 id="about-title" class="section-title" data-reveal="title">
      About
    </h2>
    <p class="section-intro" data-reveal="fade">
      Working inside government IT since 2019, from writing the apps to keeping them running.
    </p>
  </div>

  <div class="grid gap-10 lg:grid-cols-12 lg:gap-4">
    <div class="space-y-5 text-lg lg:col-span-7 lg:pr-8" data-reveal="stagger">
      <p class="text-xl leading-relaxed md:text-2xl md:leading-snug">
        I'm a Senior ICT Engineer at Guyana's National Data Management Authority, where I lead ICT
        infrastructure and technical support and deliver digital transformation projects for
        government. Proactive monitoring and automation have raised system uptime by 15%.
      </p>
      <p class="text-muted">
        I hold a Master's in Computer Software Engineering from Nankai University and a Bachelor's
        in Computer Science from the University of Guyana, and I'm an AWS Certified Cloud
        Practitioner.
      </p>
      <p class="text-muted">
        I care about systems that stay up, deploy without drama, and make sense to the next engineer
        who opens them. That's why most of my work ends up touching DevOps and automation, and why I
        spend time mentoring junior engineers.
      </p>
    </div>

    <div class="tile tile-sunken lg:col-span-5" data-reveal="fade">
      <h3 class="mb-2 text-xl font-semibold">Toolkit</h3>
      <dl>
        {categories.map((category) => (
          <div class="border-b border-line py-5 last:border-b-0 last:pb-0">
            <dt class="mb-3 text-sm font-medium text-muted">{category.name}</dt>
            <dd>
              <ul class="flex flex-wrap gap-2">
                {category.skills.map((skill) => (
                  <li class="chip border-line bg-surface">{skill}</li>
                ))}
              </ul>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
