---
import { getCollection } from 'astro:content';

import { sortByOrder } from '../utils/content';

const certifications = sortByOrder(
  (await getCollection('certifications')).map((entry) => entry.data)
);
---

<section id="certifications" class="section page-width" aria-labelledby="certifications-title">
  <div class="section-head">
    <h2 id="certifications-title" class="section-title" data-reveal="title">
      Education and certification
    </h2>
  </div>

  <ul class="border-t border-line" data-reveal="stagger">
    {certifications.map((cert) => {
      const earned = cert.date !== 'Completed' ? cert.date : undefined;
      return (
        <li class="grid gap-1 border-b border-line py-6 md:grid-cols-12 md:items-baseline md:gap-x-8">
          <h3 class="text-xl font-semibold leading-snug md:col-span-8">{cert.name}</h3>
          <p class="text-muted md:col-span-4 md:text-right">
            {earned ? `${cert.issuer}, ${earned}` : cert.issuer}
          </p>
          {cert.credentialId && cert.credentialId !== 'Your-Credential-ID' && (
            <p class="break-all text-sm text-muted md:col-span-12">
              Credential ID {cert.credentialId}
            </p>
          )}
          {cert.verifyUrl && cert.verifyUrl !== '#' && (
            <a
              href={cert.verifyUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Verify ${cert.name}`}
              class="w-fit text-sm font-semibold underline md:col-span-12"
            >
              Verify credential
            </a>
          )}
        </li>
      );
    })}
  </ul>
</section>
