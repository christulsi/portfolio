---
import { getCollection } from 'astro:content';

const certificationEntries = await getCollection('certifications');
const certifications = certificationEntries.map((entry) => entry.data);
---

<section id="certifications" class="relative bg-transparent py-24">
  <div class="container relative z-10">
    <div class="fade-in mb-14 max-w-2xl">
      <p class="kicker"><span class="text-primary">04</span>&nbsp;&nbsp;/&nbsp;&nbsp;Credentials</p>
      <h2 class="section-title mt-5">Certifications &amp; Education</h2>
      <p class="mt-4 text-lg leading-relaxed text-muted">
        Professional certifications and academic achievements that mark continuous learning.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        certifications.map((cert, index) => (
          <div
            class="panel panel-interactive group fade-in flex flex-col p-6"
            style={`transition-delay: ${index * 80}ms;`}
          >
            <div class="flex items-start gap-4">
              <div
                class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-md border border-hairline/15 bg-surface-raised/50 text-2xl transition-all duration-500 group-hover:border-primary/50"
                aria-hidden="true"
              >
                {cert.icon}
              </div>
              <div class="min-w-0">
                <h3 class="text-base font-semibold leading-tight text-ink">{cert.name}</h3>
                <p class="mt-1 font-mono text-xs text-secondary">{cert.issuer}</p>
              </div>
            </div>
            <div class="mt-5 flex items-center justify-between border-t border-hairline/10 pt-4">
              <span class="font-mono text-xs text-muted">{cert.date}</span>
              {cert.verifyUrl && cert.verifyUrl !== '#' && (
                <a
                  href={cert.verifyUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Verify ${cert.name}`}
                  class="inline-flex items-center gap-1 font-mono text-xs text-primary transition-all hover:gap-1.5"
                >
                  Verify
                  <svg
                    width="13"
                    height="13"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                    <polyline points="15 3 21 3 21 9" />
                    <line x1="10" y1="14" x2="21" y2="3" />
                  </svg>
                </a>
              )}
            </div>
            {cert.credentialId && cert.credentialId !== 'Your-Credential-ID' && (
              <p class="mt-2 font-mono text-[0.7rem] text-muted">ID: {cert.credentialId}</p>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
