---
import { getCollection } from 'astro:content';

import { sortByOrder } from '../utils/content';

const certifications = sortByOrder(
  (await getCollection('certifications')).map((entry) => entry.data)
);
---

<section id="certifications" class="section container" aria-labelledby="certifications-title">
  <div class="section-head">
    <h2 id="certifications-title" class="section-title">Education and certification</h2>
  </div>

  <ul class="grid gap-3 md:grid-cols-3 md:gap-4">
    {
      certifications.map((cert, index) => (
        <li
          class:list={[
            'tile flex flex-col justify-between gap-8',
            index === 0 ? 'tile-gold' : 'tile-sunken',
          ]}
        >
          <div>
            <p class:list={['text-sm', index === 0 ? 'font-medium' : 'text-muted']}>
              {cert.issuer}
            </p>
            <h3 class="mt-2 text-xl font-semibold leading-snug">{cert.name}</h3>
          </div>
          <div class="space-y-1 text-sm">
            {cert.date !== 'Completed' && <p>Earned {cert.date}</p>}
            {cert.credentialId && cert.credentialId !== 'Your-Credential-ID' && (
              <p class="break-all">Credential ID {cert.credentialId}</p>
            )}
            {cert.verifyUrl && cert.verifyUrl !== '#' && (
              <a
                href={cert.verifyUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Verify ${cert.name}`}
                class="font-semibold text-current underline"
              >
                Verify credential
              </a>
            )}
          </div>
        </li>
      ))
    }
  </ul>
</section>
