---
import { getCollection } from 'astro:content';

import { sortByOrder } from '../utils/content';

const experiences = sortByOrder((await getCollection('experiences')).map((entry) => entry.data));
---

<section id="experience" class="section container" aria-labelledby="experience-title">
  <div class="section-head">
    <h2 id="experience-title" class="section-title">Experience</h2>
    <p class="section-intro">Most recent first.</p>
  </div>

  <ol class="tile tile-surface py-2 md:py-4">
    {
      experiences.map((exp) => {
        const isCurrent = /present/i.test(exp.period);
        return (
          <li class="grid gap-4 border-b border-line py-8 last:border-b-0 md:grid-cols-12 md:gap-8">
            <div class="md:col-span-4 lg:col-span-3">
              <p class="font-semibold">{exp.period}</p>
              {isCurrent && (
                <p class="mt-2 inline-flex items-center gap-2 text-sm text-muted">
                  <span class="h-2 w-2 rounded-full bg-[#1f8a5b]" aria-hidden="true" />
                  Current role
                </p>
              )}
            </div>
            <div class="md:col-span-8 lg:col-span-9">
              <h3 class="font-display text-2xl md:text-3xl">{exp.title}</h3>
              <p class="mt-1 font-medium text-muted">{exp.company}</p>
              <p class="mt-4 max-w-prose">{exp.description}</p>
              <ul class="mt-5 grid gap-2 md:grid-cols-2 md:gap-x-8">
                {exp.achievements.map((achievement) => (
                  <li class="relative pl-5 text-muted before:absolute before:left-0 before:top-[0.6em] before:h-2 before:w-2 before:rounded-sm before:bg-gold before:content-['']">
                    {achievement}
                  </li>
                ))}
              </ul>
            </div>
          </li>
        );
      })
    }
  </ol>
</section>
