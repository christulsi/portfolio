---
import { getCollection } from 'astro:content';

const experienceEntries = await getCollection('experiences');
const experiences = experienceEntries.map((entry) => entry.data);
---

<section id="experience" class="relative bg-transparent py-24">
  <div class="container relative z-10">
    <div class="fade-in mb-14 max-w-2xl">
      <p class="kicker"><span class="text-primary">03</span>&nbsp;&nbsp;/&nbsp;&nbsp;Trajectory</p>
      <h2 class="section-title mt-5">Work Experience</h2>
    </div>

    <div class="timeline relative mx-auto max-w-3xl">
      {
        experiences.map((exp, index) => (
          <div
            class="timeline-item fade-in group relative pb-12 pl-12 last:pb-0"
            style={`transition-delay: ${index * 90}ms;`}
          >
            <span class="timeline-marker" aria-hidden="true" />
            <div class="panel panel-interactive relative overflow-hidden p-7">
              <span class="absolute inset-y-0 left-0 w-0.5 origin-top scale-y-0 bg-gradient-to-b from-primary to-secondary transition-transform duration-500 group-hover:scale-y-100" />
              <div class="mb-2 flex flex-wrap items-start justify-between gap-2">
                <h3 class="text-xl font-bold text-ink">{exp.title}</h3>
                <span class="tag">{exp.period}</span>
              </div>
              <p class="mb-4 font-mono text-sm text-secondary">{exp.company}</p>
              <p class="mb-6 leading-relaxed text-muted">{exp.description}</p>
              <ul class="space-y-2.5">
                {exp.achievements.map((achievement) => (
                  <li class="relative pl-7 text-muted before:absolute before:left-0 before:top-[0.15em] before:font-mono before:text-primary before:content-['▹']">
                    {achievement}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Continuous spine behind the markers. */
  .timeline::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 6px;
    bottom: 6px;
    width: 1px;
    background: linear-gradient(
      to bottom,
      rgb(var(--accent) / 0.5),
      rgb(var(--border) / 0.15) 30%,
      rgb(var(--border) / 0.15)
    );
  }

  .timeline-marker {
    position: absolute;
    left: 0;
    top: 6px;
    width: 11px;
    height: 11px;
    border-radius: 9999px;
    background: rgb(var(--accent));
    box-shadow: 0 0 0 4px rgb(var(--accent) / 0.18);
    transition:
      transform 0.4s ease,
      box-shadow 0.4s ease;
  }

  .group:hover .timeline-marker {
    transform: scale(1.25);
    box-shadow: 0 0 0 6px rgb(var(--accent) / 0.28);
  }
</style>
