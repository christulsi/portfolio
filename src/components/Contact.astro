---
import { Icon } from 'astro-icon/components';

const channels = [
  {
    icon: 'heroicons:envelope-20-solid',
    label: 'Email',
    value: 'christulsi@gmail.com',
    href: 'mailto:christulsi@gmail.com',
  },
  {
    icon: 'heroicons:code-bracket-square-20-solid',
    label: 'GitHub',
    value: '@christulsi',
    href: 'https://github.com/christulsi',
    external: true,
  },
  {
    icon: 'heroicons:user-group-20-solid',
    label: 'LinkedIn',
    value: 'in/chris-tulsi',
    href: 'https://www.linkedin.com/in/chris-tulsi/',
    external: true,
  },
];
---

<section id="contact" class="relative bg-transparent py-24">
  <div class="container relative z-10">
    <div class="fade-in mb-14 max-w-2xl">
      <p class="kicker"><span class="text-primary">06</span>&nbsp;&nbsp;/&nbsp;&nbsp;Contact</p>
      <h2 class="section-title mt-5">Let's build something reliable</h2>
      <p class="mt-4 text-lg leading-relaxed text-muted">
        Always open to new opportunities and collaborations. Drop a line and I'll get back to you.
      </p>
    </div>

    <div class="grid gap-12 md:grid-cols-[0.85fr_1.15fr] md:gap-16">
      <div class="fade-in flex flex-col gap-4">
        {
          channels.map((c) => (
            <a
              href={c.href}
              target={c.external ? '_blank' : undefined}
              rel={c.external ? 'noopener noreferrer' : undefined}
              class="panel panel-interactive group flex items-center gap-4 p-5"
            >
              <span class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-md border border-hairline/15 text-primary transition-colors group-hover:border-primary/50">
                <Icon name={c.icon} class="h-5 w-5" />
              </span>
              <span>
                <span class="block font-mono text-xs uppercase tracking-widest text-muted">
                  {c.label}
                </span>
                <span class="mt-0.5 block text-sm text-ink transition-colors group-hover:text-primary">
                  {c.value}
                </span>
              </span>
            </a>
          ))
        }
      </div>

      <form id="contact-form" class="panel relative overflow-hidden p-8">
        <span
          class="absolute left-0 top-0 h-px w-full bg-gradient-to-r from-primary to-secondary"
          aria-hidden="true"></span>

        <div class="relative mb-6">
          <label
            for="name"
            class="mb-2 block font-mono text-xs uppercase tracking-widest text-muted">Name</label
          >
          <input
            type="text"
            id="name"
            name="name"
            autocomplete="name"
            required
            minlength="2"
            class="w-full rounded-md border border-hairline/15 bg-surface/50 px-4 py-3 text-ink transition-all placeholder:text-muted focus:border-primary focus:outline-hidden focus:ring-2 focus:ring-primary/30"
          />
          <div class="field-icon hidden" id="name-icon"></div>
          <p class="mt-1 hidden text-xs text-red-600 dark:text-red-400" id="name-error">
            Name must be at least 2 characters
          </p>
        </div>

        <div class="relative mb-6">
          <label
            for="email"
            class="mb-2 block font-mono text-xs uppercase tracking-widest text-muted">Email</label
          >
          <input
            type="email"
            id="email"
            name="email"
            autocomplete="email"
            required
            class="w-full rounded-md border border-hairline/15 bg-surface/50 px-4 py-3 text-ink transition-all placeholder:text-muted focus:border-primary focus:outline-hidden focus:ring-2 focus:ring-primary/30"
          />
          <div class="field-icon hidden" id="email-icon"></div>
          <p class="mt-1 hidden text-xs text-red-600 dark:text-red-400" id="email-error">
            Please enter a valid email address
          </p>
        </div>

        <div class="relative mb-6">
          <label
            for="message"
            class="mb-2 block font-mono text-xs uppercase tracking-widest text-muted">Message</label
          >
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            minlength="10"
            maxlength="500"
            class="w-full resize-y rounded-md border border-hairline/15 bg-surface/50 px-4 py-3 text-ink transition-all placeholder:text-muted focus:border-primary focus:outline-hidden focus:ring-2 focus:ring-primary/30"
          ></textarea>
          <p class="mt-1 text-right font-mono text-xs text-muted">
            <span id="char-count">0</span>/500
          </p>
          <p class="mt-1 hidden text-xs text-red-600 dark:text-red-400" id="message-error">
            Message must be at least 10 characters
          </p>
        </div>

        <button
          type="submit"
          id="submit-btn"
          class="btn-primary btn-enhanced w-full disabled:cursor-not-allowed disabled:opacity-50"
        >
          <span id="submit-text">Send Message</span>
          <span id="submit-loading" class="hidden">Sending…</span>
        </button>
      </form>
    </div>
  </div>
</section>

<script>
  import { ContactFormSchema, validateContactForm } from '@schemas/form.schema';
  import {
    clearFieldValidation,
    serializeForm,
    showFieldError,
    showFieldSuccess,
  } from '@utils/form';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const submitText = document.getElementById('submit-text');
  const submitLoading = document.getElementById('submit-loading');
  const charCount = document.getElementById('char-count');

  const nameInput = document.getElementById('name') as HTMLInputElement | null;
  const emailInput = document.getElementById('email') as HTMLInputElement | null;
  const messageInput = document.getElementById('message') as HTMLTextAreaElement | null;

  // Per-field validation icons (presentational; not part of @utils/form)
  const checkIconSvg =
    '<svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>';
  const errorIconSvg =
    '<svg class="w-5 h-5 text-red-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>';

  function setFieldIcon(fieldId: string, kind: 'success' | 'error' | 'hidden') {
    const icon = document.getElementById(`${fieldId}-icon`);
    if (!icon) return;
    if (kind === 'hidden') {
      icon.classList.add('hidden');
      icon.innerHTML = '';
      return;
    }
    icon.innerHTML = kind === 'success' ? checkIconSvg : errorIconSvg;
    icon.classList.remove('hidden');
  }

  /**
   * Validate a single field against its Zod sub-schema.
   * Returns true when valid; updates DOM either way.
   */
  function validateField(fieldId: 'name' | 'email' | 'message', value: string): boolean {
    // Don't show validation state for an untouched empty field — match prior UX
    if (value.length === 0) {
      clearFieldValidation(fieldId);
      setFieldIcon(fieldId, 'hidden');
      return false;
    }
    const result = ContactFormSchema.shape[fieldId].safeParse(value);
    if (result.success) {
      showFieldSuccess(fieldId);
      // Message field doesn't have a check icon in the markup
      if (fieldId !== 'message') setFieldIcon(fieldId, 'success');
      return true;
    }
    showFieldError(fieldId, result.error.issues[0]?.message ?? 'Invalid value');
    if (fieldId !== 'message') setFieldIcon(fieldId, 'error');
    return false;
  }

  // Character counter for message
  messageInput?.addEventListener('input', () => {
    if (charCount) charCount.textContent = messageInput.value.length.toString();
  });

  // Real-time validation: on blur first, then on input after the field has been touched
  const blurred = { name: false, email: false, message: false };

  function attachFieldValidation(
    fieldId: 'name' | 'email' | 'message',
    el: HTMLInputElement | HTMLTextAreaElement | null
  ) {
    if (!el) return;
    el.addEventListener('blur', () => {
      blurred[fieldId] = true;
      validateField(fieldId, el.value);
    });
    el.addEventListener('input', () => {
      if (blurred[fieldId]) validateField(fieldId, el.value);
    });
  }

  attachFieldValidation('name', nameInput);
  attachFieldValidation('email', emailInput);
  attachFieldValidation('message', messageInput);

  // Ripple effect on submit button
  submitBtn?.addEventListener('click', function (this: HTMLElement) {
    if (!submitBtn.disabled) {
      this.classList.add('ripple');
      setTimeout(() => {
        this.classList.remove('ripple');
      }, 600);
    }
  });

  function showToast(detail: {
    message: string;
    type: 'success' | 'error' | 'info';
    duration?: number;
  }) {
    window.dispatchEvent(new CustomEvent('toast:show', { detail }));
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !submitBtn || !submitText || !submitLoading) return;

    // Source of truth: Zod schema. Surfaces all field errors at once.
    const data = serializeForm(form);
    const result = validateContactForm(data);

    if (!result.success) {
      (Object.keys(result.errors) as Array<'name' | 'email' | 'message'>).forEach((field) => {
        showFieldError(field, result.errors[field] ?? 'Invalid value');
        if (field !== 'message') setFieldIcon(field, 'error');
      });
      showToast({
        message: 'Please fix the errors in the form',
        type: 'error',
        duration: 5000,
      });
      return;
    }

    // Show loading state
    submitBtn.disabled = true;
    submitText.classList.add('hidden');
    submitLoading.classList.remove('hidden');

    try {
      // Using FormSubmit.co — free, no signup required
      const response = await fetch('https://formsubmit.co/christulsi@gmail.com', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
        },
        body: JSON.stringify({
          name: result.data.name,
          email: result.data.email,
          message: result.data.message,
          _subject: `Portfolio Contact from ${result.data.name}`,
          _captcha: 'false',
        }),
      });

      if (!response.ok) throw new Error('Form submission failed');

      showToast({
        message: 'Thank you! Your message has been sent successfully.',
        type: 'success',
        duration: 5000,
      });
      form.reset();
      (['name', 'email', 'message'] as const).forEach((field) => {
        clearFieldValidation(field);
        if (field !== 'message') setFieldIcon(field, 'hidden');
        blurred[field] = false;
      });
      if (charCount) charCount.textContent = '0';
    } catch {
      showToast({
        message: 'Oops! Something went wrong. Please try again or email me directly.',
        type: 'error',
        duration: 5000,
      });
    } finally {
      submitBtn.disabled = false;
      submitText.classList.remove('hidden');
      submitLoading.classList.add('hidden');
    }
  });
</script>
