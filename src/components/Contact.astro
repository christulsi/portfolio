---
import { Icon } from 'astro-icon/components';

const channels = [
  {
    label: 'Email',
    value: 'christulsi@gmail.com',
    href: 'mailto:christulsi@gmail.com',
    icon: 'heroicons:envelope-20-solid',
    external: false,
  },
  {
    label: 'GitHub',
    value: '@christulsi',
    href: 'https://github.com/christulsi',
    icon: 'heroicons:code-bracket-square-20-solid',
    external: true,
  },
  {
    label: 'LinkedIn',
    value: 'linkedin.com/in/chris-tulsi',
    href: 'https://www.linkedin.com/in/chris-tulsi/',
    icon: 'heroicons:user-group-20-solid',
    external: true,
  },
];
---

<section id="contact" class="section container" aria-labelledby="contact-title">
  <div class="tile tile-forest grid gap-10 p-6 md:p-10 lg:grid-cols-12 lg:gap-12 lg:p-14">
    <div class="flex flex-col gap-8 lg:col-span-5">
      <div>
        <h2 id="contact-title" class="section-title">
          Get in touch
        </h2>
        <p class="mt-5 max-w-md text-lg text-on-forest/85">
          I'm open to new roles, public-sector consulting and collaborations. Email is the fastest
          way to reach me; the form sends to the same inbox.
        </p>
      </div>
      <ul class="mt-auto divide-y divide-on-forest/20 border-y border-on-forest/20">
        {channels.map((channel) => (
          <li>
            <a
              href={channel.href}
              {...(channel.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              class="group flex items-center gap-4 py-4 text-on-forest no-underline"
            >
              <Icon name={channel.icon} class="h-5 w-5 flex-shrink-0 text-gold" />
              <span class="flex flex-col">
                <span class="text-sm text-on-forest/80">{channel.label}</span>
                <span class="font-semibold group-hover:underline">{channel.value}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <form id="contact-form" class="rounded-[1.25rem] bg-surface p-6 text-ink md:p-8 lg:col-span-7">
      <div class="grid gap-5 md:grid-cols-2">
        <div class="relative">
          <label for="name" class="mb-2 block font-semibold">
            Name
          </label>
          <input
            type="text"
            id="name"
            name="name"
            autocomplete="name"
            required
            minlength="2"
            class="w-full rounded-xl border border-line bg-canvas px-4 py-3 text-ink transition-colors focus:border-link focus:outline-none focus:ring-2 focus:ring-link/25 pr-11"
          />
          <div class="field-icon hidden" id="name-icon"></div>
          <p class="mt-1 hidden text-sm text-red-700 dark:text-red-300" id="name-error">
            Name must be at least 2 characters
          </p>
        </div>
        <div class="relative">
          <label for="email" class="mb-2 block font-semibold">
            Email
          </label>
          <input
            type="email"
            id="email"
            name="email"
            autocomplete="email"
            required
            class="w-full rounded-xl border border-line bg-canvas px-4 py-3 text-ink transition-colors focus:border-link focus:outline-none focus:ring-2 focus:ring-link/25 pr-11"
          />
          <div class="field-icon hidden" id="email-icon"></div>
          <p class="mt-1 hidden text-sm text-red-700 dark:text-red-300" id="email-error">
            Please enter a valid email address
          </p>
        </div>
      </div>
      <div class="mt-5">
        <label for="message" class="mb-2 block font-semibold">
          Message
        </label>
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          minlength="10"
          maxlength="500"
          class="w-full rounded-xl border border-line bg-canvas px-4 py-3 text-ink transition-colors focus:border-link focus:outline-none focus:ring-2 focus:ring-link/25 resize-y"
        ></textarea>
        <div class="mt-1 flex justify-between gap-4 text-sm">
          <p class="hidden text-red-700 dark:text-red-300" id="message-error">
            Message must be at least 10 characters
          </p>
          <p class="ml-auto text-muted">
            <span id="char-count">0</span>/500
          </p>
        </div>
      </div>
      <button
        type="submit"
        id="submit-btn"
        class="btn btn-gold mt-6 w-full cursor-pointer disabled:cursor-not-allowed disabled:opacity-60"
      >
        <span id="submit-text">Send message</span>
        <span id="submit-loading" class="hidden">
          Sending…
        </span>
      </button>
    </form>
  </div>
</section>

<script>
  import { ContactFormSchema, validateContactForm } from '@schemas/form.schema';
  import {
    clearFieldValidation,
    serializeForm,
    showFieldError,
    showFieldSuccess,
  } from '@utils/form';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const submitText = document.getElementById('submit-text');
  const submitLoading = document.getElementById('submit-loading');
  const charCount = document.getElementById('char-count');

  const nameInput = document.getElementById('name') as HTMLInputElement | null;
  const emailInput = document.getElementById('email') as HTMLInputElement | null;
  const messageInput = document.getElementById('message') as HTMLTextAreaElement | null;

  // Per-field validation icons (presentational; not part of @utils/form)
  const checkIconSvg =
    '<svg class="w-5 h-5 text-[#1f8a5b]" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>';
  const errorIconSvg =
    '<svg class="w-5 h-5 text-[#c2410c]" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>';

  function setFieldIcon(fieldId: string, kind: 'success' | 'error' | 'hidden') {
    const icon = document.getElementById(`${fieldId}-icon`);
    if (!icon) return;
    if (kind === 'hidden') {
      icon.classList.add('hidden');
      icon.innerHTML = '';
      return;
    }
    icon.innerHTML = kind === 'success' ? checkIconSvg : errorIconSvg;
    icon.classList.remove('hidden');
  }

  /**
   * Validate a single field against its Zod sub-schema.
   * Returns true when valid; updates DOM either way.
   */
  function validateField(fieldId: 'name' | 'email' | 'message', value: string): boolean {
    // Don't show validation state for an untouched empty field — match prior UX
    if (value.length === 0) {
      clearFieldValidation(fieldId);
      setFieldIcon(fieldId, 'hidden');
      return false;
    }
    const result = ContactFormSchema.shape[fieldId].safeParse(value);
    if (result.success) {
      showFieldSuccess(fieldId);
      // Message field doesn't have a check icon in the markup
      if (fieldId !== 'message') setFieldIcon(fieldId, 'success');
      return true;
    }
    showFieldError(fieldId, result.error.issues[0]?.message ?? 'Invalid value');
    if (fieldId !== 'message') setFieldIcon(fieldId, 'error');
    return false;
  }

  // Character counter for message
  messageInput?.addEventListener('input', () => {
    if (charCount) charCount.textContent = messageInput.value.length.toString();
  });

  // Real-time validation: on blur first, then on input after the field has been touched
  const blurred = { name: false, email: false, message: false };

  function attachFieldValidation(
    fieldId: 'name' | 'email' | 'message',
    el: HTMLInputElement | HTMLTextAreaElement | null
  ) {
    if (!el) return;
    el.addEventListener('blur', () => {
      blurred[fieldId] = true;
      validateField(fieldId, el.value);
    });
    el.addEventListener('input', () => {
      if (blurred[fieldId]) validateField(fieldId, el.value);
    });
  }

  attachFieldValidation('name', nameInput);
  attachFieldValidation('email', emailInput);
  attachFieldValidation('message', messageInput);

  function showToast(detail: {
    message: string;
    type: 'success' | 'error' | 'info';
    duration?: number;
  }) {
    window.dispatchEvent(new CustomEvent('toast:show', { detail }));
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !submitBtn || !submitText || !submitLoading) return;

    // Source of truth: Zod schema. Surfaces all field errors at once.
    const data = serializeForm(form);
    const result = validateContactForm(data);

    if (!result.success) {
      (Object.keys(result.errors) as Array<'name' | 'email' | 'message'>).forEach((field) => {
        showFieldError(field, result.errors[field] ?? 'Invalid value');
        if (field !== 'message') setFieldIcon(field, 'error');
      });
      showToast({
        message: 'Check the highlighted fields and try again.',
        type: 'error',
        duration: 5000,
      });
      return;
    }

    // Show loading state
    submitBtn.disabled = true;
    submitText.classList.add('hidden');
    submitLoading.classList.remove('hidden');

    try {
      // Using FormSubmit.co — free, no signup required
      const response = await fetch('https://formsubmit.co/christulsi@gmail.com', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
        },
        body: JSON.stringify({
          name: result.data.name,
          email: result.data.email,
          message: result.data.message,
          _subject: `Portfolio Contact from ${result.data.name}`,
          _captcha: 'false',
        }),
      });

      if (!response.ok) throw new Error('Form submission failed');

      showToast({
        message: "Message sent. I'll reply to the email address you gave.",
        type: 'success',
        duration: 5000,
      });
      form.reset();
      (['name', 'email', 'message'] as const).forEach((field) => {
        clearFieldValidation(field);
        if (field !== 'message') setFieldIcon(field, 'hidden');
        blurred[field] = false;
      });
      if (charCount) charCount.textContent = '0';
    } catch {
      showToast({
        message:
          "Your message couldn't be sent. Try again, or email christulsi@gmail.com directly.",
        type: 'error',
        duration: 5000,
      });
    } finally {
      submitBtn.disabled = false;
      submitText.classList.remove('hidden');
      submitLoading.classList.add('hidden');
    }
  });
</script>
