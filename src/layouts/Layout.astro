---
import { SEO } from 'astro-seo';
import { ClientRouter } from 'astro:transitions';
// NEW: Lenis base styles (html height, stopped state).
import 'lenis/dist/lenis.css';

import Cursor from '../components/Cursor.astro';
import Loader from '../components/Loader.astro';
import Toast from '../components/Toast.astro';
import { personJsonLd } from '../data/structured-data';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
  /** NEW: page has the intro loader + hero entrance (home page). */
  intro?: boolean;
}

const {
  title,
  description = 'Senior ICT Engineer specializing in ERP, data engineering, and AI/ML solutions. Building scalable software for government and enterprise.',
  image = '/og-image.png',
  type = 'website',
  intro = false,
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(`${base}${image.replace(/^\//, '')}`, Astro.site);
---

<!doctype html>
<html lang="en" data-has-intro={intro ? '' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO Meta Tags -->
    <SEO
      title={title}
      description={description}
      canonical={canonicalURL.toString()}
      openGraph={{
        basic: {
          title,
          type,
          image: imageURL.toString(),
          url: Astro.url.toString(),
        },
        optional: {
          description,
          siteName: 'Chris Tulsi - Portfolio',
        },
        image: {
          alt: 'Chris Tulsi - Senior ICT Engineer Portfolio',
        },
      }}
      twitter={{
        card: 'summary_large_image',
        site: '@christulsi',
        creator: '@christulsi',
        title,
        description,
        image: imageURL.toString(),
        imageAlt: 'Chris Tulsi - Senior ICT Engineer Portfolio',
      }}
      extend={{
        meta: [
          { name: 'theme-color', content: '#0c4a34' },
          { name: 'msapplication-TileColor', content: '#0c4a34' },
          { name: 'generator', content: Astro.generator },
          { name: 'author', content: 'Chris Tulsi' },
          {
            name: 'keywords',
            content:
              'Chris Tulsi, Senior ICT Engineer, Software Engineer, ERP Systems, Data Engineering, AI/ML, AWS, Cloud Computing, DevOps, Python, JavaScript, Frappe, ERPNext, Portfolio',
          },
          { name: 'robots', content: 'index, follow' },
          {
            name: 'googlebot',
            content: 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1',
          },
          { property: 'og:locale', content: 'en_US' },
          { property: 'article:author', content: 'Chris Tulsi' },
        ],
      }}
    />

    <!-- Favicons (relative to base — keeps manifest start_url same-origin in any env) -->
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="192x192" href={`${base}favicon-192x192.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />

    <!-- View Transitions for smooth page navigation -->
    <ClientRouter />

    <!-- Structured Data (JSON-LD) for SEO -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
    <!-- Archivo (variable width + weight). Preloaded and applied without
         blocking render; the expanded width drives the display type.
         NEW: width range starts at 75 so the hero name can widen into place. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..125,400..800&display=swap"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..125,400..800&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <script is:inline>
      // Runs before first paint, once per full page load.
      (() => {
        const root = document.documentElement;

        // Dark mode: localStorage > system preference > light fallback.
        let stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch {
          /* storage blocked */
        }
        const prefersDark =
          window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        root.setAttribute(
          'data-theme',
          stored === 'light' || stored === 'dark' ? stored : prefersDark ? 'dark' : 'light'
        );

        // NEW: motion. `motion` gates every hidden-until-animated state in CSS,
        // so reduced motion and no-JS always render the finished page.
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          root.classList.add('motion');
          // The intro loader plays once per session, on the home page, and not
          // when the visitor deep-links to a section.
          if (root.hasAttribute('data-has-intro') && !location.hash) {
            try {
              if (sessionStorage.getItem('intro-seen') !== '1') {
                sessionStorage.setItem('intro-seen', '1');
                root.classList.add('is-loading');
              }
            } catch {
              /* storage blocked: skip the loader */
            }
          }
        }

        // NEW: client-side navigation replaces <html>'s attributes with the
        // next page's server-rendered ones. Carry runtime state across: the
        // theme, and classes like `motion`, `intro-done`, `has-cursor`, `lenis`.
        document.addEventListener('astro:before-swap', (ev) => {
          const next = ev.newDocument.documentElement;
          next.setAttribute('data-theme', root.getAttribute('data-theme') || 'light');
          root.classList.forEach((name) => {
            if (name !== 'is-loading' && name !== 'intro-running') next.classList.add(name);
          });
        });
      })();
    </script>
  </head>
  <body>
    <!-- Site-wide constellation background: fixed, behind all content, and
         persisted across client-side navigations so it animates uninterrupted. -->
    <div id="three-root" transition:persist aria-hidden="true"></div>
    <!-- NEW: intro loader (home only) and custom cursor (fine pointers only). -->
    {intro && <Loader />}
    <Cursor />
    <a href="#main" class="skip-link">
      Skip to main content
    </a>
    <Toast />
    <slot />
    <script>
      // NEW: the motion layer — Lenis, GSAP reveals, cursor, intro, 3D scroll.
      import '../scripts/motion/index';
      import { scrollToTarget } from '../scripts/motion/scroll-to';

      // Re-runs on every client-side navigation via ClientRouter, in addition to
      // the initial page load. DOMContentLoaded would only fire once.
      function scrollToHash() {
        const id = location.hash.replace(/^#/, '');
        if (id) {
          setTimeout(() => {
            const target = document.getElementById(id);
            if (target) scrollToTarget(target);
          }, 50);
        }
      }

      window.addEventListener('hashchange', scrollToHash);
      document.addEventListener('astro:page-load', scrollToHash);
    </script>
    <script>
      // Lazy-load the 3D scene (constellation + hero arrowhead). Keeps the
      // three.js chunk out of the critical path and off data-saver devices.
      // The #three-root element persists across navigations and the module
      // guards against double-init, so re-importing on each page-load is
      // effectively free.
      function maybeLoadThree() {
        try {
          if (localStorage.getItem('disableThree') === '1') return;
          const conn = (navigator as Navigator & { connection?: { saveData?: boolean } })
            .connection;
          if (conn?.saveData) return;
          const load = () => void import('../scripts/three/index.ts');
          // NEW: phones get a lighter scene (it used to be skipped below 640px),
          // loaded once the main thread is idle so it never competes with first
          // paint.
          if (window.innerWidth < 768 && 'requestIdleCallback' in window) {
            window.requestIdleCallback(load, { timeout: 2500 });
          } else {
            load();
          }
        } catch (err) {
          console.error('Failed to load constellation background:', err);
        }
      }
      document.addEventListener('astro:page-load', maybeLoadThree);
    </script>
  </body>
</html>

<style is:global>
  @tailwind base;
  @tailwind components;
  @tailwind utilities;

  @layer base {
    /* Palette: the forest green and gold of Guyana's Golden Arrowhead. Values
       are RGB channels so Tailwind opacity modifiers work (see tailwind.config). */
    :root {
      --canvas: 243 246 242; /* #F3F6F2 */
      --surface: 255 255 255;
      --sunken: 230 237 231; /* #E6EDE7 */
      --ink: 14 34 25; /* #0E2219 */
      --muted: 75 97 87; /* #4B6157 */
      --line: 211 221 214; /* #D3DDD6 */
      --link: 10 107 71; /* #0A6B47 */
      --gold: 244 196 48; /* #F4C430 */
      --on-gold: 14 34 25;
      --forest: 12 74 52; /* #0C4A34 */
      --on-forest: 236 245 239; /* #ECF5EF */
      color-scheme: light;
    }

    [data-theme='dark'] {
      /* Deep forest, not near-black: the canvas is the light theme's ink. */
      --canvas: 14 34 25; /* #0E2219 */
      --surface: 20 48 39; /* #143027 */
      --sunken: 27 58 47; /* #1B3A2F */
      --ink: 233 241 236; /* #E9F1EC */
      --muted: 159 182 171; /* #9FB6AB */
      --line: 42 74 61; /* #2A4A3D */
      --link: 244 196 48; /* gold reads as the link color on dark green */
      --forest: 15 84 59; /* #0F543B */
      color-scheme: dark;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 5rem;
      -webkit-text-size-adjust: 100%;
    }

    /* NEW: Lenis drives the scroll position itself; native smoothing would
       fight every frame it sets. */
    html.lenis {
      scroll-behavior: auto;
    }

    /* NEW: 17px body on a 1.65 rhythm — a touch larger and airier. */
    body {
      @apply bg-canvas text-ink font-sans antialiased;
      font-size: 1.0625rem;
      line-height: 1.65;
    }

    h1,
    h2,
    h3,
    h4 {
      @apply leading-tight;
      text-wrap: balance;
    }

    p,
    li,
    blockquote {
      text-wrap: pretty;
    }

    a {
      @apply text-link underline-offset-4 transition-colors;
    }

    ::selection {
      background: rgb(var(--gold));
      color: rgb(var(--on-gold));
    }

    :focus-visible {
      outline: 3px solid rgb(var(--link));
      outline-offset: 3px;
    }

    *:focus:not(:focus-visible) {
      @apply outline-none;
    }
  }

  @layer components {
    /* NEW: wider measure for the grid, fluid gutters. */
    .container {
      width: 100%;
      max-width: 84rem;
      margin-inline: auto;
      padding-inline: clamp(1.25rem, 4vw, 3.5rem);
    }

    /* Two-step type scale on Archivo's width axis. The widest, heaviest cut is
       reserved for the name (and the wordmark/404 that echo it) — the site's one
       loud typographic move. Headings step down in both width and weight. */
    .font-display {
      font-stretch: 125%;
      font-weight: 800;
      letter-spacing: -0.025em;
    }

    .font-heading {
      font-stretch: 112%;
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    /* NEW: more air between sections and a bigger, tighter heading scale. */
    .section {
      padding-block: clamp(5rem, 11vw, 9rem);
    }

    .section-head {
      @apply mb-10 flex flex-col gap-4 md:mb-16 md:flex-row md:items-end md:justify-between md:gap-12;
    }

    .section-title {
      @apply font-heading;
      font-size: clamp(2.6rem, 6.2vw, 5.5rem);
      line-height: 0.96;
      letter-spacing: -0.035em;
    }

    .section-intro {
      @apply max-w-md text-lg text-muted md:text-right;
    }

    /* NEW: lead paragraph size, shared by the hero and project pages. */
    .lede {
      font-size: clamp(1.15rem, 1.5vw, 1.375rem);
      line-height: 1.5;
    }

    /* Bento tiles. Treatments vary by role rather than one card style everywhere. */
    .tile {
      @apply rounded-tile p-6 md:p-8;
    }

    .tile-surface {
      @apply border border-line bg-surface;
    }

    .tile-sunken {
      @apply bg-sunken;
    }

    .tile-forest {
      @apply bg-forest text-on-forest;
    }

    .tile-gold {
      @apply bg-gold text-on-gold;
    }

    .btn {
      @apply inline-flex h-12 items-center justify-center gap-2 rounded-full px-6 font-semibold no-underline transition;
    }

    .btn-gold {
      @apply bg-gold text-on-gold hover:bg-gold/85;
    }

    .btn-ghost {
      @apply border border-line text-ink hover:border-ink;
    }

    .chip {
      @apply inline-block rounded-full border px-3 py-1 text-sm leading-snug;
    }

    .skip-link {
      @apply absolute -top-24 left-4 z-[10000] rounded-full bg-gold px-6 py-3 font-semibold text-on-gold no-underline focus:top-4;
    }

    /* Site-wide constellation background. Sits above the body background but
       behind all page content; never intercepts pointer events. */
    #three-root {
      position: fixed;
      inset: 0;
      z-index: -1;
      pointer-events: none;
    }

    /* NEW: Masked words for staggered heading reveals (motion/split.ts). The
       padding/negative-margin pair keeps ascenders and descenders unclipped
       without changing the line box. */
    .split-word {
      display: inline-block;
      overflow: hidden;
      vertical-align: top;
      padding-block: 0.12em 0.14em;
      margin-block: -0.12em -0.14em;
    }

    .split-inner {
      display: inline-block;
    }

    /* NEW: Intro states. Hidden only while JS-driven motion is allowed and the
       intro hasn't finished; the failsafe reveals everything if the motion
       script never starts. */
    html.motion:not(.intro-done) [data-intro-item] {
      opacity: 0;
    }

    html.motion:not(.intro-done) .hero-line > span {
      transform: translateY(105%);
    }

    html.motion:not(.intro-done):not(.intro-running) :is([data-intro-item], .hero-line > span) {
      animation: intro-failsafe 0.6s ease-out 4s forwards;
    }

    @keyframes intro-failsafe {
      to {
        opacity: 1;
        transform: none;
      }
    }

    /* NEW: 3D tilt cards (motion/tilt.ts) and their pointer-following sheen. */
    .tilt-stage {
      perspective: 1400px;
    }

    [data-tilt] {
      transform-style: preserve-3d;
    }

    /* NEW: native cursor hidden while the custom one is active, except where
       typing needs the caret. */
    html.has-cursor,
    html.has-cursor * {
      cursor: none;
    }

    html.has-cursor :is(input, textarea, select, [contenteditable='true']) {
      cursor: auto;
    }

    /* One orchestrated entrance, used by the hero tiles only. */
    .rise {
      animation: rise 640ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
      animation-delay: calc(var(--i, 0) * 80ms);
    }

    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(16px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }

    /* Form field validation states (toggled by @utils/form) */
    .field-valid {
      border-color: #1f8a5b !important;
    }

    .field-invalid {
      border-color: #c2410c !important;
    }

    .field-icon {
      position: absolute;
      right: 12px;
      top: 2.9rem;
      pointer-events: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    .rise {
      animation: none;
    }
  }

  /* NEW: never print half-revealed content. */
  @media print {
    [data-reveal],
    [data-reveal] > *,
    .split-inner,
    [data-intro-item],
    .hero-line > span {
      opacity: 1 !important;
      visibility: visible !important;
      transform: none !important;
    }
  }
</style>
