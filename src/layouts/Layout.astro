---
import { SEO } from 'astro-seo';
import { ClientRouter } from 'astro:transitions';
// NEW: Lenis base styles (html height, stopped state).
import 'lenis/dist/lenis.css';

import Cursor from '../components/Cursor.astro';
import Loader from '../components/Loader.astro';
import Toast from '../components/Toast.astro';
import { personJsonLd } from '../data/structured-data';
// Global styles + Tailwind v4 entry (tokens, base, components, motion states).
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
  /** NEW: page has the intro loader + hero entrance (home page). */
  intro?: boolean;
}

const {
  title,
  description = 'Senior ICT Engineer specializing in ERP, data engineering, and AI/ML solutions. Building scalable software for government and enterprise.',
  image = '/og-image.png',
  type = 'website',
  intro = false,
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(`${base}${image.replace(/^\//, '')}`, Astro.site);
---

<!doctype html>
<html lang="en" data-has-intro={intro ? '' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO Meta Tags -->
    <SEO
      title={title}
      description={description}
      canonical={canonicalURL.toString()}
      openGraph={{
        basic: {
          title,
          type,
          image: imageURL.toString(),
          url: Astro.url.toString(),
        },
        optional: {
          description,
          siteName: 'Chris Tulsi - Portfolio',
        },
        image: {
          alt: 'Chris Tulsi - Senior ICT Engineer Portfolio',
        },
      }}
      twitter={{
        card: 'summary_large_image',
        site: '@christulsi',
        creator: '@christulsi',
        title,
        description,
        image: imageURL.toString(),
        imageAlt: 'Chris Tulsi - Senior ICT Engineer Portfolio',
      }}
      extend={{
        meta: [
          { name: 'theme-color', content: '#0c4a34' },
          { name: 'msapplication-TileColor', content: '#0c4a34' },
          { name: 'generator', content: Astro.generator },
          { name: 'author', content: 'Chris Tulsi' },
          {
            name: 'keywords',
            content:
              'Chris Tulsi, Senior ICT Engineer, Software Engineer, ERP Systems, Data Engineering, AI/ML, AWS, Cloud Computing, DevOps, Python, JavaScript, Frappe, ERPNext, Portfolio',
          },
          { name: 'robots', content: 'index, follow' },
          {
            name: 'googlebot',
            content: 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1',
          },
          { property: 'og:locale', content: 'en_US' },
          { property: 'article:author', content: 'Chris Tulsi' },
        ],
      }}
    />

    <!-- Favicons (relative to base — keeps manifest start_url same-origin in any env) -->
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="192x192" href={`${base}favicon-192x192.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />

    <!-- View Transitions for smooth page navigation -->
    <ClientRouter />

    <!-- Structured Data (JSON-LD) for SEO -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
    <!-- Archivo (variable width + weight). Preloaded and applied without
         blocking render; the expanded width drives the display type.
         NEW: width range starts at 75 so the hero name can widen into place. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..125,400..800&display=swap"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..125,400..800&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <script is:inline>
      // Runs before first paint, once per full page load.
      (() => {
        const root = document.documentElement;

        // Dark mode: localStorage > system preference > light fallback.
        let stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch {
          /* storage blocked */
        }
        const prefersDark =
          window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        root.setAttribute(
          'data-theme',
          stored === 'light' || stored === 'dark' ? stored : prefersDark ? 'dark' : 'light'
        );

        // NEW: motion. `motion` gates every hidden-until-animated state in CSS,
        // so reduced motion and no-JS always render the finished page.
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          root.classList.add('motion');
          // The intro loader plays once per session, on the home page, and not
          // when the visitor deep-links to a section.
          if (root.hasAttribute('data-has-intro') && !location.hash) {
            try {
              if (sessionStorage.getItem('intro-seen') !== '1') {
                sessionStorage.setItem('intro-seen', '1');
                root.classList.add('is-loading');
              }
            } catch {
              /* storage blocked: skip the loader */
            }
          }
        }

        // NEW: client-side navigation replaces <html>'s attributes with the
        // next page's server-rendered ones. Carry runtime state across: the
        // theme, and classes like `motion`, `intro-done`, `has-cursor`, `lenis`.
        document.addEventListener('astro:before-swap', (ev) => {
          const next = ev.newDocument.documentElement;
          next.setAttribute('data-theme', root.getAttribute('data-theme') || 'light');
          root.classList.forEach((name) => {
            if (name !== 'is-loading' && name !== 'intro-running') next.classList.add(name);
          });
        });
      })();
    </script>
  </head>
  <body>
    <!-- Site-wide constellation background: fixed, behind all content, and
         persisted across client-side navigations so it animates uninterrupted. -->
    <div id="three-root" transition:persist aria-hidden="true"></div>
    <!-- NEW: intro loader (home only) and custom cursor (fine pointers only). -->
    {intro && <Loader />}
    <Cursor />
    <a href="#main" class="skip-link">
      Skip to main content
    </a>
    <Toast />
    <slot />
    <script>
      // NEW: the motion layer — Lenis, GSAP reveals, cursor, intro, 3D scroll.
      import '../scripts/motion/index';
      import { scrollToTarget } from '../scripts/motion/scroll-to';

      // Re-runs on every client-side navigation via ClientRouter, in addition to
      // the initial page load. DOMContentLoaded would only fire once.
      function scrollToHash() {
        const id = location.hash.replace(/^#/, '');
        if (id) {
          setTimeout(() => {
            const target = document.getElementById(id);
            if (target) scrollToTarget(target);
          }, 50);
        }
      }

      window.addEventListener('hashchange', scrollToHash);
      document.addEventListener('astro:page-load', scrollToHash);
    </script>
    <script>
      // Lazy-load the 3D scene (constellation + hero arrowhead). Keeps the
      // three.js chunk out of the critical path and off data-saver devices.
      // The #three-root element persists across navigations and the module
      // guards against double-init, so re-importing on each page-load is
      // effectively free.
      function maybeLoadThree() {
        try {
          if (localStorage.getItem('disableThree') === '1') return;
          const conn = (navigator as Navigator & { connection?: { saveData?: boolean } })
            .connection;
          if (conn?.saveData) return;
          const load = () => void import('../scripts/three/index.ts');
          // NEW: phones get a lighter scene (it used to be skipped below 640px),
          // loaded once the main thread is idle so it never competes with first
          // paint.
          if (window.innerWidth < 768 && 'requestIdleCallback' in window) {
            window.requestIdleCallback(load, { timeout: 2500 });
          } else {
            load();
          }
        } catch (err) {
          console.error('Failed to load constellation background:', err);
        }
      }
      document.addEventListener('astro:page-load', maybeLoadThree);
    </script>
  </body>
</html>
