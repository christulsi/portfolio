---
import { SEO } from 'astro-seo';
import { ClientRouter } from 'astro:transitions';

import Toast from '../components/Toast.astro';
import { personJsonLd } from '../data/structured-data';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
}

const {
  title,
  description = 'Senior ICT Engineer specializing in ERP, data engineering, and AI/ML solutions. Building scalable software for government and enterprise.',
  image = '/og-image.png',
  type = 'website',
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(`${base}${image.replace(/^\//, '')}`, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO Meta Tags -->
    <SEO
      title={title}
      description={description}
      canonical={canonicalURL.toString()}
      openGraph={{
        basic: {
          title,
          type,
          image: imageURL.toString(),
          url: Astro.url.toString(),
        },
        optional: {
          description,
          siteName: 'Chris Tulsi - Portfolio',
        },
        image: {
          alt: 'Chris Tulsi - Senior ICT Engineer Portfolio',
        },
      }}
      twitter={{
        card: 'summary_large_image',
        site: '@christulsi',
        creator: '@christulsi',
        title,
        description,
        image: imageURL.toString(),
        imageAlt: 'Chris Tulsi - Senior ICT Engineer Portfolio',
      }}
      extend={{
        meta: [
          { name: 'theme-color', content: '#0b0d11' },
          { name: 'msapplication-TileColor', content: '#0b0d11' },
          { name: 'generator', content: Astro.generator },
          { name: 'author', content: 'Chris Tulsi' },
          {
            name: 'keywords',
            content:
              'Chris Tulsi, Senior ICT Engineer, Software Engineer, ERP Systems, Data Engineering, AI/ML, AWS, Cloud Computing, DevOps, Python, JavaScript, Frappe, ERPNext, Portfolio',
          },
          { name: 'robots', content: 'index, follow' },
          {
            name: 'googlebot',
            content: 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1',
          },
          { property: 'og:locale', content: 'en_US' },
          { property: 'article:author', content: 'Chris Tulsi' },
        ],
      }}
    />

    <!-- Favicons (relative to base — keeps manifest start_url same-origin in any env) -->
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="192x192" href={`${base}favicon-192x192.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />

    <!-- View Transitions for smooth page navigation -->
    <ClientRouter />

    <!-- Structured Data (JSON-LD) for SEO -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

    <!-- Type system: Instrument Serif (display) + Hanken Grotesk (UI/body) +
         JetBrains Mono (data/labels). Loaded non-blocking (preload → stylesheet)
         with display=swap so first paint never waits on the network. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;700&display=swap"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;700&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <script is:inline>
      // Mark that JS is available so scroll-reveal content can default to hidden
      // only when it can actually be revealed (see `.fade-in` styles).
      document.documentElement.classList.add('js');

      // Dark mode initialization (runs before page render to prevent flash)
      // Priority: localStorage > system preference > light fallback
      (() => {
        const stored = localStorage.getItem('theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.setAttribute('data-theme', stored);
          return;
        }
        const prefersDark =
          window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute('data-theme', prefersDark ? 'dark' : 'light');
      })();
    </script>
  </head>
  <body>
    <!-- Blueprint grid + atmospheric depth. Sits at the very back; pure CSS,
         theme-aware via custom properties. -->
    <div id="bg-grid" aria-hidden="true"></div>
    <!-- Site-wide constellation background: fixed, behind all content, and
         persisted across client-side navigations so it animates uninterrupted. -->
    <div id="three-root" transition:persist aria-hidden="true"></div>
    <div id="scroll-progress" aria-hidden="true"></div>
    <a href="#main" class="skip-link">Skip to main content</a>
    <Toast />
    <slot />
    <script>
      // Re-runs on every client-side navigation via ClientRouter, in addition to
      // the initial page load. DOMContentLoaded would only fire once.
      function setupPage() {
        // Intersection Observer for fade-in elements
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
        );
        document.querySelectorAll('.fade-in').forEach((el) => observer.observe(el));

        // Hash navigation after route change
        if (location.hash) {
          const id = location.hash.replace(/^#/, '');
          setTimeout(() => document.getElementById(id)?.scrollIntoView({ behavior: 'smooth' }), 50);
        }
      }

      // Single shared scroll handler for the progress bar; attached once per
      // document. ClientRouter persists window listeners across navigations.
      const scrollProgress = document.getElementById('scroll-progress');
      let ticking = false;
      function updateScrollProgress() {
        const windowHeight =
          document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrolled = windowHeight > 0 ? window.scrollY / windowHeight : 0;
        if (scrollProgress) scrollProgress.style.transform = `scaleX(${scrolled})`;
        ticking = false;
      }
      window.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            window.requestAnimationFrame(updateScrollProgress);
            ticking = true;
          }
        },
        { passive: true }
      );
      window.addEventListener('hashchange', () => {
        const id = location.hash.replace(/^#/, '');
        if (id) {
          setTimeout(() => document.getElementById(id)?.scrollIntoView({ behavior: 'smooth' }), 50);
        }
      });

      document.addEventListener('astro:page-load', setupPage);
    </script>
    <script>
      // Lazy-load the constellation background only when the device can handle
      // it. Keeps the three.js chunk out of the critical path and off small /
      // data-saver devices. The #three-root element persists across navigations
      // and the module guards against double-init, so re-importing on each
      // page-load is effectively free.
      function maybeLoadThree() {
        try {
          if (localStorage.getItem('disableThree') === '1') return;
          const conn = (navigator as Navigator & { connection?: { saveData?: boolean } })
            .connection;
          if (conn?.saveData) return;
          if (window.innerWidth < 640) return;
          void import('../scripts/three/index.ts');
        } catch (err) {
          console.error('Failed to load constellation background:', err);
        }
      }
      document.addEventListener('astro:page-load', maybeLoadThree);
    </script>
  </body>
</html>

<style is:global>
  @tailwind base;
  @tailwind components;
  @tailwind utilities;

  /* ---------------------------------------------------------------------
     Design tokens — "Instrument" theme.
     Warm-ink canvas, a single signal-amber accent, muted teal as a cue.
     Stored as RGB channel triplets so Tailwind's /alpha modifiers work.
     --------------------------------------------------------------------- */
  :root,
  [data-theme='light'] {
    --bg: 245 241 233; /* warm bone */
    --bg-2: 237 231 220;
    --surface: 255 254 249;
    --surface-2: 248 244 236;
    --text: 26 24 21; /* warm near-black */
    --text-muted: 88 82 73;
    --border: 26 24 21;
    --accent: 138 84 6; /* deep ochre — contrast-safe as text on bone */
    --accent-strong: 112 66 4;
    --accent-light: 196 124 22;
    --accent-contrast: 255 254 249; /* sits on accent fills */
    --accent-2: 13 110 102; /* deep teal */
    --accent-2-light: 18 138 128;
    --glow: 196 124 22;
    --grid-line: 26 24 21;
  }

  [data-theme='dark'] {
    --bg: 11 13 17; /* warm ink */
    --bg-2: 8 10 13;
    --surface: 21 24 30;
    --surface-2: 28 32 39;
    --text: 233 229 220; /* warm off-white */
    --text-muted: 159 165 172;
    --border: 255 255 255;
    --accent: 243 178 75; /* signal amber */
    --accent-strong: 249 168 47;
    --accent-light: 247 198 122;
    --accent-contrast: 18 16 12; /* ink, sits on amber */
    --accent-2: 94 234 212; /* terminal teal */
    --accent-2-light: 153 246 228;
    --glow: 243 178 75;
    --grid-line: 255 255 255;
  }

  @layer base {
    html {
      scroll-behavior: smooth;
      scroll-padding-top: 5.5rem; /* keep anchors clear of the sticky header */
    }

    * {
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    body {
      @apply font-sans leading-relaxed;
      color: rgb(var(--text));
      background-color: rgb(var(--bg));
      /* soft warm light raking in from the top-right for depth */
      background-image: radial-gradient(
        1100px 760px at 82% -10%,
        rgb(var(--glow) / 0.13),
        transparent 62%
      );
      background-attachment: fixed;
    }

    ::selection {
      background: rgb(var(--accent) / 0.28);
      color: rgb(var(--text));
    }

    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
      @apply leading-tight;
      color: rgb(var(--text));
      font-weight: 700;
    }

    /* Instrument Serif ships a single (400) weight — never synthesize bold. */
    .font-display {
      font-weight: 400 !important;
      letter-spacing: -0.01em;
    }

    a {
      color: rgb(var(--accent));
      text-decoration: none;
      transition: color 0.25s ease;
    }

    a:hover {
      color: rgb(var(--accent-strong));
    }

    a:focus-visible,
    button:focus-visible,
    input:focus-visible,
    textarea:focus-visible {
      outline: 2px solid rgb(var(--accent));
      outline-offset: 2px;
      border-radius: 2px;
    }

    *:focus:not(:focus-visible) {
      @apply outline-none;
    }
  }

  /* Blueprint grid + depth, masked to a soft drafting-table falloff. */
  #bg-grid {
    position: fixed;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    background-image:
      linear-gradient(to right, rgb(var(--grid-line) / 0.06) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(var(--grid-line) / 0.06) 1px, transparent 1px);
    background-size: 64px 64px;
    -webkit-mask-image: radial-gradient(ellipse 120% 78% at 50% 0%, #000 32%, transparent 88%);
    mask-image: radial-gradient(ellipse 120% 78% at 50% 0%, #000 32%, transparent 88%);
  }

  @layer components {
    .container {
      @apply max-w-6xl mx-auto px-6 lg:px-8;
    }

    /* Scroll-reveal (IntersectionObserver-driven, below the fold). */
    .fade-in {
      opacity: 0;
      transform: translateY(2rem);
      transition:
        opacity 600ms cubic-bezier(0.22, 1, 0.36, 1),
        transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .fade-in.visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* No-JS fallback: content stays visible if the observer never runs. */
    html:not(.js) .fade-in {
      opacity: 1;
      transform: none;
    }

    /* Mono kicker / eyebrow that precedes section + block titles. */
    .kicker {
      @apply inline-flex items-center gap-3 font-mono text-xs font-medium uppercase;
      letter-spacing: 0.28em;
      color: rgb(var(--accent));
    }

    .kicker::before {
      content: '';
      width: 1.6rem;
      height: 1px;
      background: currentColor;
      opacity: 0.7;
    }

    .section-title {
      @apply font-display;
      font-weight: 400;
      line-height: 0.98;
      letter-spacing: -0.015em;
      font-size: clamp(2.25rem, 1.4rem + 3.6vw, 3.6rem);
    }

    /* Engineered surface panel. */
    .panel {
      position: relative;
      background: rgb(var(--surface) / 0.72);
      border: 1px solid rgb(var(--border) / 0.12);
      border-radius: 0.75rem;
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }

    .panel-interactive {
      transition:
        transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
        border-color 0.45s ease,
        box-shadow 0.45s ease;
    }

    .panel-interactive:hover {
      transform: translateY(-4px);
      border-color: rgb(var(--accent) / 0.55);
      box-shadow: 0 22px 60px -28px rgb(var(--accent) / 0.5);
    }

    /* Mono data chip. */
    .tag {
      @apply inline-flex items-center font-mono text-xs px-2.5 py-1 rounded;
      color: rgb(var(--text-muted));
      background: rgb(var(--text) / 0.04);
      border: 1px solid rgb(var(--border) / 0.12);
      transition:
        color 0.3s ease,
        border-color 0.3s ease,
        background 0.3s ease,
        transform 0.3s ease;
    }

    .tag:hover {
      color: rgb(var(--accent));
      border-color: rgb(var(--accent) / 0.5);
      transform: translateY(-1px);
    }

    .skip-link {
      @apply absolute -top-24 left-4 px-6 py-3 no-underline font-semibold rounded-md z-[10000] focus:top-4;
      background: rgb(var(--accent));
      color: rgb(var(--accent-contrast));
    }

    /* Buttons */
    .btn-primary {
      @apply inline-flex items-center justify-center gap-2 px-6 py-3 rounded-md font-semibold transition-all duration-300;
      background: rgb(var(--accent));
      color: rgb(var(--accent-contrast)) !important;
      border: 1px solid transparent;
    }

    .btn-primary:hover {
      background: rgb(var(--accent-strong));
      transform: translateY(-2px);
      box-shadow: 0 16px 40px -14px rgb(var(--accent) / 0.65);
    }

    .btn-outline {
      @apply inline-flex items-center justify-center gap-2 px-6 py-3 rounded-md font-semibold transition-all duration-300;
      background: transparent;
      color: rgb(var(--accent)) !important;
      border: 1px solid rgb(var(--accent) / 0.5);
    }

    .btn-outline:hover {
      background: rgb(var(--accent) / 0.1);
      border-color: rgb(var(--accent));
      transform: translateY(-2px);
    }

    /* Animated skill chip — fills with accent on hover. */
    .skill-tag {
      @apply font-mono text-xs px-3 py-1.5 rounded;
      color: rgb(var(--text-muted));
      background: rgb(var(--text) / 0.03);
      border: 1px solid rgb(var(--border) / 0.14);
      transition:
        color 0.3s ease,
        background 0.3s ease,
        border-color 0.3s ease,
        transform 0.3s ease;
    }

    .skill-tag:hover {
      color: rgb(var(--accent-contrast));
      background: rgb(var(--accent));
      border-color: rgb(var(--accent));
      transform: translateY(-2px);
    }

    /* Site-wide constellation background. */
    #three-root {
      position: fixed;
      inset: 0;
      z-index: -1;
      pointer-events: none;
    }

    #scroll-progress {
      @apply fixed top-0 left-0 z-[10001];
      height: 2px;
      width: 100%;
      background: linear-gradient(to right, rgb(var(--accent)), rgb(var(--accent-2)));
      transform: scaleX(0);
      transform-origin: left;
      will-change: transform;
    }

    /* Enhanced button with ripple + shimmer. */
    .btn-enhanced {
      position: relative;
      overflow: hidden;
      isolation: isolate;
    }

    .btn-enhanced::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(
        90deg,
        transparent 0%,
        rgba(255, 255, 255, 0.28) 50%,
        transparent 100%
      );
      background-size: 200% 100%;
      background-position: -200% center;
      opacity: 0;
      transition: opacity 0.3s ease;
      z-index: -1;
    }

    .btn-enhanced:hover::before {
      opacity: 1;
      animation: shimmer 2s ease-in-out infinite;
    }

    .btn-enhanced::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0;
      height: 0;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.5);
      transform: translate(-50%, -50%);
      opacity: 0;
      pointer-events: none;
      z-index: -1;
    }

    .btn-enhanced.ripple::after {
      animation: ripple 0.6s ease-out;
    }

    /* Form field validation states */
    .field-valid {
      @apply border-green-500 dark:border-green-400;
    }

    .field-invalid {
      @apply border-red-500 dark:border-red-400;
      animation: shake 0.4s ease-in-out;
    }

    .field-icon {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      pointer-events: none;
    }
  }

  /* Respect reduced motion — snap every animation/transition to its end. */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.001ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>
