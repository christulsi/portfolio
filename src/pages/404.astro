---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';

// Use Astro's base path for proper URL resolution
const base = import.meta.env.BASE_URL;
---

<Layout title="404 - Page Not Found | Chris Tulsi">
  <Header />
  <main id="main">
    <section class="relative flex min-h-[80vh] items-center overflow-hidden py-24">
      <div class="container relative z-10">
        <div class="fade-in mx-auto max-w-2xl text-center">
          <p class="kicker justify-center">Error — Signal Lost</p>

          <h1 class="font-display mt-6 text-[clamp(6rem,18vw,12rem)] leading-none text-primary">
            404
          </h1>

          <h2 class="mt-2 text-3xl font-bold sm:text-4xl">Page Not Found</h2>

          <p class="mx-auto mt-4 max-w-md leading-relaxed text-muted">
            The page you're looking for doesn't exist — it may have been moved, renamed, or never
            deployed.
          </p>

          <div class="panel mx-auto mt-10 max-w-md p-8 text-left">
            <h3 class="font-mono text-xs uppercase tracking-[0.28em] text-muted">
              Suggested routes
            </h3>
            <ul class="mt-5 space-y-3 font-mono text-sm">
              <li class="flex items-start gap-3 text-muted">
                <span class="text-primary" aria-hidden="true">↳</span> Check the URL for typos
              </li>
              <li class="flex items-start gap-3 text-muted">
                <span class="text-primary" aria-hidden="true">↳</span> Return to the homepage
              </li>
              <li class="flex items-start gap-3 text-muted">
                <span class="text-primary" aria-hidden="true">↳</span> Browse projects or get in touch
              </li>
            </ul>
          </div>

          <div class="mt-10 flex flex-col justify-center gap-4 sm:flex-row">
            <a href={base} class="btn-primary">Go Home <span aria-hidden="true">→</span></a>
            <a href={`${base}#projects`} class="btn-outline">View Projects</a>
            <a href={`${base}#contact`} class="btn-outline">Contact Me</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
