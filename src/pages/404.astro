---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';

// Use Astro's base path for proper URL resolution
const base = import.meta.env.BASE_URL;
---

<Layout title="404 - Page Not Found | Chris Tulsi">
  <Header />
  <main id="main" class="container py-10 md:py-16">
    <div class="grid gap-3 md:gap-4 lg:grid-cols-12">
      <div class="rise tile tile-surface lg:col-span-8 md:p-12" style="--i: 0">
        <h1 class="font-display text-[clamp(6rem,22vw,13rem)] leading-[0.85] tracking-tight">
          404
        </h1>
        <p class="mt-8 text-2xl font-semibold">This page doesn't exist.</p>
        <p class="mt-2 max-w-md text-lg text-muted">
          The link may be mistyped, or the page may have moved. Everything on this site lives on the
          home page.
        </p>
        <div class="mt-10 flex flex-col gap-3 sm:flex-row">
          <a href={base} class="btn btn-gold">
            Go to the home page
          </a>
          <a href={`${base}#contact`} class="btn btn-ghost">
            Get in touch
          </a>
        </div>
      </div>
      <nav
        class="rise tile tile-forest flex flex-col justify-end lg:col-span-4"
        style="--i: 1"
        aria-label="Site sections"
      >
        <p class="mb-4 text-sm text-on-forest/80">Or jump to a section</p>
        <ul class="divide-y divide-on-forest/20 border-y border-on-forest/20">
          {[
            { id: 'projects', label: 'Selected work' },
            { id: 'about', label: 'About' },
            { id: 'experience', label: 'Experience' },
          ].map((link) => (
            <li>
              <a
                href={`${base}#${link.id}`}
                class="block py-4 text-xl font-semibold text-on-forest no-underline hover:underline"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </main>
  <Footer />
</Layout>
