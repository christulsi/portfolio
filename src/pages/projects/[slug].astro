---
// NEW: One page per project, generated from the projects collection. The
// cover and title share view-transition names with the card on the home
// page, so clicking a card morphs it into this page (Astro ClientRouter).
// Content comes straight from the collection entry — nothing new is invented.
import { getCollection } from 'astro:content';

import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ProjectCover from '../../components/ProjectCover.astro';
import Layout from '../../layouts/Layout.astro';
import { projectPath, sortByOrder } from '../../utils/content';

export async function getStaticPaths() {
  const projects = sortByOrder(
    (await getCollection('projects')).map((entry) => ({ ...entry.data, slug: entry.id }))
  );
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(index + 1) % projects.length] ?? project },
  }));
}

const { project, next } = Astro.props;
const base = import.meta.env.BASE_URL ?? '/';

// Meta descriptions read best under ~155 characters.
const description =
  project.description.length > 155
    ? `${project.description.slice(0, 152).replace(/\s+\S*$/, '')}…`
    : project.description;
---

<Layout title={`${project.title} | Chris Tulsi`} description={description} type="article">
  <Header />
  <main id="main" class="container pb-8 pt-8 md:pt-12">
    <a href={`${base}#projects`} class="inline-flex items-center gap-2 font-semibold" data-magnetic>
      <svg viewBox="0 0 20 20" class="h-4 w-4" fill="currentColor" aria-hidden="true">
        <path
          fill-rule="evenodd"
          d="M12.79 5.23a.75.75 0 0 1-.02 1.06L8.83 10l3.94 3.71a.75.75 0 1 1-1.04 1.08l-4.5-4.25a.75.75 0 0 1 0-1.08l4.5-4.25a.75.75 0 0 1 1.06.02Z"
          clip-rule="evenodd"
        ></path>
      </svg>
      All selected work
    </a>

    <header class="mt-10 md:mt-14">
      {project.client && (
        <p class="text-lg text-muted" data-reveal="fade">
          {project.client}
        </p>
      )}
      <h1
        class="project-title font-heading mt-3 max-w-5xl"
        transition:name={`project-title-${project.slug}`}
      >
        {project.title}
      </h1>
    </header>

    <ProjectCover
      slug={project.slug}
      title={project.title}
      outcome={project.outcome}
      cover={project.cover}
      size="page"
      class="mt-10 md:mt-14"
    />

    <div class="mt-12 grid gap-12 md:mt-16 lg:grid-cols-12 lg:gap-16">
      <section class="lg:col-span-7" aria-labelledby="overview-title" data-reveal="fade">
        <h2 id="overview-title" class="text-sm font-semibold text-muted">
          Overview
        </h2>
        <p class="lede mt-4">{project.description}</p>
      </section>

      <section class="lg:col-span-5" aria-labelledby="stack-title" data-reveal="fade">
        <h2 id="stack-title" class="text-sm font-semibold text-muted">
          Technologies
        </h2>
        <ul class="mt-4 flex flex-wrap gap-2">
          {project.technologies.map((tech) => (
            <li class="chip border-line bg-surface">{tech}</li>
          ))}
        </ul>
        {project.githubUrl && (
          <a
            href={project.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-8 inline-block font-semibold underline"
          >
            View source on GitHub
          </a>
        )}
      </section>
    </div>

    {next.slug !== project.slug && (
      <nav class="mt-20 md:mt-28" aria-label="Next project" data-reveal="fade">
        <a
          href={projectPath(base, next.slug)}
          class="tile tile-forest group flex flex-col gap-3 text-on-forest no-underline md:flex-row md:items-end md:justify-between"
          data-cursor="view"
          data-cursor-label="Next"
        >
          <span class="text-sm text-on-forest/80">Next project</span>
          <span class="font-heading text-3xl group-hover:underline md:text-5xl">{next.title}</span>
        </a>
      </nav>
    )}

    <p class="mt-10">
      <a href={`${base}#contact`} class="font-semibold">
        Talk to me about a project like this
      </a>
    </p>
  </main>
  <Footer />
</Layout>

<style>
  .project-title {
    font-size: clamp(2.6rem, 7vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.035em;
  }
</style>
